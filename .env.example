# Copy to .env (loaded automatically) or set in your hosting environment
PORT=3000
BASE_URL=http://localhost:3000          # public URL, used for links in emails
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gblogix.com           # first admin, created on first start
ADMIN_PASSWORD=change-me
TZ_OFFICE=America/Los_Angeles

# Company letterhead on A/N, D/O, ATME
COMPANY_EMAIL=info@gblogix.com
COMPANY_ADDRESS=1661 N. Raymond Ave., Suite 140F, Anaheim, CA 92801
COMPANY_PHONE=
COMPANY_DOT=4406045
COMPANY_REMIT=                          # bank / payment instructions on the freight invoice

# ---- Email: Outlook / Microsoft 365 (recommended) ----
# Azure portal > App registrations > New; API permissions (Application): Mail.Send (+ Mail.ReadWrite for intake)
# Grant admin consent; restrict to the mailbox with an Exchange ApplicationAccessPolicy.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=info@gblogix.com
MS_MAIL_INTAKE=off                      # on = agent emails with PDFs -> Document intake
MS_INTAKE_FOLDER=inbox
MS_INTAKE_MINUTES=10

# ---- Email: SMTP alternative (used only when MS_* is empty) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GlobalBridge Logistics <info@gblogix.com>"

# ---- Tracking (ETD / ETA / vessel) ----
TERMINAL49_API_KEY=                     # ocean, by MBL (paid plan or trial needed to read data)
TERMINAL49_WEBHOOK_SECRET=              # webhook URL: <BASE_URL>/webhooks/terminal49
SHIPSGO_API_KEY=                        # ocean + air (MAWB)
# Carrier APIs (DCSA Track & Trace), JSON per SCAC:
# DCSA_CARRIERS={"HLCU":{"baseUrl":"https://api.hlag.com/hlag/external","headers":{"X-IBM-Client-Id":"...","X-IBM-Client-Secret":"..."}}}
DCSA_CARRIERS=
DATALASTIC_API_KEY=                     # vessel GPS by IMO (mid-ocean)
AISSTREAM_API_KEY=                      # free vessel GPS by MMSI (coastal)
TRACKING_INTERVAL_HOURS=4

# ---- Smartsheet (shared sheets with Unlockt etc.) ----
SMARTSHEET_TOKEN=                       # Smartsheet > Personal settings > API access > generate token
# SMARTSHEET_SHEETS=[{"id":8215963652542340,"preset":"unlockt","customer":"UNLOCKT BRANDS, INC"}]   # optional; default = discover by sheet name
SMARTSHEET_MINUTES=30

# ---- Documents ----
CHROMIUM_PATH=                          # for PDF output; or: npx playwright install --with-deps chromium
OCR=on                                  # scanned PDFs / photos
OCR_LANGS=eng                           # eng+kor for Korean documents

# ---- Optional: AI document extraction (best for scans and unusual layouts) ----
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
