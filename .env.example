# Copy to .env (or set in your hosting environment)
PORT=3000
BASE_URL=http://localhost:3000          # public URL, used for links in emails
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@gblogix.com           # first admin, created on first start
ADMIN_PASSWORD=change-me

# Email (leave SMTP_HOST empty to only log emails in the Outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GlobalBridge Logistics <info@gblogix.com>"

# Company letterhead on A/N, D/O, ATME
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=info@gblogix.com

# Optional: AI document extraction (scanned PDFs, unusual layouts, P/L lines from PDFs)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
