<%- include('../partials/head') %>
<div class="pagehead"><h1><%= history ? 'Shipment history' : isInternal ? title : 'Assigned shipments' %></h1>
  <% if (isInternal && !history && can('shipments_edit')) { %><a class="btn" href="/shipments/new">+ New shipment</a><% } %>
</div>
<% if (history) { %><p class="muted small" style="margin-top:-8px">Closed files — the customer's invoices are paid. Kept here for look-up; reopen a file from its page if something comes up.</p><% } %>
<form class="filters" method="get">
  <% if (isInternal && !history) { %>
    <div class="seg">
      <% Object.entries(STAGES).forEach(([k, label]) => { %><a class="<%= stage === k && !bill ? 'on' : '' %>" href="?stage=<%= k %><%= mode ? `&mode=${mode}` : '' %><%= mine ? '&mine=1' : '' %>"><%= label %></a><% }) %>
      <a href="/history">History (closed)</a>
    </div>
    <label class="check small" style="margin:0"><input type="checkbox" name="mine" value="1" <%= mine ? 'checked' : '' %> onchange="this.form.submit()"> My files only</label>
    <input type="hidden" name="stage" value="<%= stage %>">
  <% } %>
  <input name="q" value="<%= q %>" placeholder="Search shipper, container, MBL, HBL, customer, file no…">
  <% if (!history) { %><select name="status"><option value="">All statuses</option><% S.STATUSES.forEach((x) => { %><option value="<%= x.code %>" <%= status === x.code ? 'selected' : '' %>><%= x.label %></option><% }) %></select><% } %>
  <select name="mode"><option value="">All modes</option><option value="OCEAN" <%= mode === 'OCEAN' ? 'selected' : '' %>>Ocean (FCL + LCL)</option><% Object.entries(S.MODES).forEach(([k, m]) => { %><option value="<%= k %>" <%= mode === k ? 'selected' : '' %>><%= m.label %></option><% }) %></select>
  <% if (canAccounting && !history) { %><select name="bill"><option value="">Any billing</option>
    <option value="not_invoiced" <%= bill === 'not_invoiced' ? 'selected' : '' %>>Delivered — not invoiced</option>
    <option value="unpaid" <%= bill === 'unpaid' ? 'selected' : '' %>>Invoiced — not paid</option>
    <option value="overdue" <%= bill === 'overdue' ? 'selected' : '' %>>Overdue</option>
    <option value="to_book" <%= bill === 'to_book' ? 'selected' : '' %>>Vendor invoice to book</option>
    <option value="no_cost" <%= bill === 'no_cost' ? 'selected' : '' %>>Delivered — no cost booked</option></select><% } %>
  <select name="sort" onchange="this.form.submit()" title="Order by ETA (actual arrival when known)">
    <option value="asc" <%= (sort || (history ? 'desc' : 'asc')) === 'asc' ? 'selected' : '' %>>ETA ↑ next arrival first</option>
    <option value="desc" <%= (sort || (history ? 'desc' : 'asc')) === 'desc' ? 'selected' : '' %>>ETA ↓ latest first</option></select>
  <button class="btn secondary">Filter</button>
</form>
<% const work = isInternal && !history && can('shipments_edit'); const LAB = { urgent: 'Urgent', important: 'Important', traffic: 'Traffic', document: 'Document' }; %>
<% if (isInternal && !history) { %><div class="list-summary">
  <a class="sum-chip" href="/containers?tab=pickup">📦 <b><%= locals.pickupCount || 0 %></b> container(s) to pick up</a>
  <span class="muted small"><%= rows.length %> result(s)<%= mode ? ` · ${mode}` : '' %><%= q ? ` · "${q}"` : '' %><%= status ? ` · ${S.statusLabel(status)}` : '' %></span>
  <button type="button" class="btn secondary small" data-colcfg="files" style="margin-left:auto">⚙ Columns</button>
</div><% } %>
<form method="post" action="/bulk/shipments" data-bulk>
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="<%= path %><%= locals.query ? '' : '' %>">
<% if (work && rows.length) { %><div class="bulkbar">
  <span class="small muted">Checked (<span data-bulk-count>0</span>):</span>
  <select name="owner_id" aria-label="New OP"><option value="">Change OP to…</option><% (locals.staffUsers || []).forEach((u) => { %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select>
  <button class="btn secondary small" name="action" value="owner" data-bulk-btn disabled>Change OP</button>
  <select name="color_label" aria-label="Label"><option value="">Label…</option><% Object.entries(LAB).forEach(([k, v]) => { %><option value="<%= k %>"><%= v %></option><% }) %></select>
  <button class="btn secondary small" name="action" value="label" data-bulk-btn disabled>Set label</button>
  <% if (can('send_notices')) { %><button class="btn secondary small" name="action" value="send-an" data-bulk-btn disabled data-confirm="Send the A/N and documents to the customs broker of each checked file?">✉ Arrival notice</button><% } %>
  <input name="reason" placeholder="Block reason" style="width:140px">
  <button class="btn secondary small" name="action" value="block" data-bulk-btn disabled>🔒 Block</button>
  <button class="btn secondary small" name="action" value="unblock" data-bulk-btn disabled>🔓 Unblock</button>
  <% if (user.role === 'admin') { %><a class="btn secondary small" href="/insights/negative">Profit report</a><% } %>
</div><% } %>
<div class="tablewrap">
<table class="t worklist" data-cols="files" data-csrf="<%= csrf %>">
  <thead><tr>
    <% if (work) { %><th style="width:26px"><input type="checkbox" data-bulk-all title="Select all"></th><th title="Flag">⚑</th><% } %>
    <th>File (Shipper · Container)</th><% if (isInternal && !history) { %><th>Internal message</th><th>Label</th><th>Journey</th><th>Hold</th><% } %><th>Mode</th><th>Customer</th><th>MBL / HBL</th><th>ETD</th><th>ETA</th>
    <th>Status</th><th>Customs</th><th>A/N</th><th>D/O</th><% if (canAccounting) { %><th>Billing</th><% if (history) { %><th class="right">Profit</th><% } %><% } %><th><%= history ? 'Closed' : 'Delivery' %></th>
  </tr></thead>
  <tbody>
  <% if (!rows.length) { %><tr><td colspan="20" class="muted">No shipments found.</td></tr><% } %>
  <% rows.forEach((s) => { const b = canAccounting ? S.billingState(s) : null; %>
    <tr class="<%= s.blocked_at ? 'row-blocked' : '' %>">
      <% if (work) { %><td><input type="checkbox" name="ids" value="<%= s.id %>" data-bulk-item></td>
        <td><input type="checkbox" class="flagbox" data-quick="/quick/shipments/<%= s.id %>" data-field="flagged" <%= s.flagged ? 'checked' : '' %> title="Flag" aria-label="Flag"></td><% } %>
      <td><a href="/shipments/<%= s.id %>"><b><%= S.fileName(s) %></b></a><% if (s.blocked_at) { %> <span title="Blocked<%= s.block_reason ? `: ${s.block_reason}` : '' %>">⛔</span><% } %><% if (s.locked_at) { %> <span title="Locked — accounting finished">🔒</span><% } %><br><span class="muted small mono"><%= s.ref_no %></span><% if (s.owner_name) { %> <span class="muted small">· <%= s.owner_name %></span><% } %></td>
      <% if (isInternal && !history) { const j = locals.journey ? journey(s) : null; %>
        <td><% if (work) { %><input class="note" data-quick="/quick/shipments/<%= s.id %>" data-field="internal_note" value="<%= s.internal_note || '' %>" placeholder="Add note…"><% } else { %><span class="small"><%= s.internal_note || '' %></span><% } %></td>
        <td><% if (work) { %><select class="lab lab-<%= s.color_label || 'none' %>" data-quick="/quick/shipments/<%= s.id %>" data-field="color_label" aria-label="Label"><option value="">—</option><% Object.entries(LAB).forEach(([k, v]) => { %><option value="<%= k %>" <%= s.color_label === k ? 'selected' : '' %>>● <%= v %></option><% }) %></select><% } else if (s.color_label) { %><span class="lab-<%= s.color_label %> small">● <%= LAB[s.color_label] %></span><% } %></td>
        <td class="small nowrap"><% if (j) { %><%- include('../partials/stagepop', { st: j }) %><% } %></td>
        <td><%= s.holds || s.blocked_at ? '✔' : '' %></td>
      <% } %>
      <td class="nowrap"><%= S.MODES[s.mode].icon %> <%= s.mode %></td>
      <td><%= s.customer_name || '—' %></td>
      <td class="mono small"><%= s.mbl_no || '—' %><br><%= s.hbl_no || '—' %></td>
      <td class="nowrap"><%= s.etd || '' %></td>
      <td class="nowrap"><b><%= s.eta || '' %></b></td>
      <td><span class="badge <%= s.status %>"><%= S.statusLabel(s.status) %></span></td>
      <td><span class="badge <%= s.customs_status %>"><%= s.customs_status %></span></td>
      <td><%= s.an_sent_at ? '✔' : '' %></td>
      <td><%= s.do_sent_at ? '✔' : '' %></td>
      <% if (canAccounting) { const c = S.costState(s); %><td class="nowrap small"><% if (b) { %><span class="badge bill-<%= b.level %>"><%= b.label %></span><% if (b.amount) { %><br>$<%= fmtNum(b.amount, 2) %> open<% } %><% } %><% if (c) { %><br><span class="badge bill-<%= c.level %>"><%= c.label %></span><% } %></td>
        <% if (history) { %><td class="right nowrap"><% if (s.pl) { %><b style="color:<%= s.pl.profit >= 0 ? 'var(--green)' : 'var(--red)' %>"><%= fmtNum(s.pl.profit, 2) %></b><% } %></td><% } %><% } %>
      <td class="small"><%= history ? fmtDate(s.closed_at) : `${s.delivery_date || ''} ${s.delivery_time || ''}` %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
</form>
<%- include('../partials/foot') %>
