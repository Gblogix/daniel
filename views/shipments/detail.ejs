<%- include('../partials/head') %>
<% const T = locals.tools || {}; const locked = Boolean(s.locked_at); const editOk = can('shipments_edit') && !locked; const isAdmin = user.role === 'admin'; %>
<% if (locked) { %><div class="lockbar" role="status"><span class="blockicon">🔒</span><div><b>Locked — accounting finished</b>
  <div class="small"><%= s.locked_by ? `Locked by ${T.lockedBy || 'admin'}` : 'Locked automatically (all invoices and bills paid)' %> on <%= fmtDateTime(s.locked_at) %> UTC · the file and its invoices can't be changed. Memos, documents and emails still work.</div></div>
  <% if (isAdmin) { %><form method="post" action="/shipments/<%= s.id %>/lock" class="lock-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="on" value="0">
    <input name="reason" required maxlength="300" placeholder="Reason for unlocking (required)" aria-label="Reason for unlocking"><button class="btn small secondary">🔓 Unlock</button></form><% } %></div>
<% } else if (s.lock_released_at) { %><div class="lockbar released" role="status"><span class="blockicon">🔓</span><div><b>Unlocked by <%= T.releasedBy || 'admin' %></b> on <%= fmtDateTime(s.lock_released_at) %> UTC: <%= s.lock_release_reason %>
  <div class="small">It will not lock itself again — lock it when the change is done.</div></div>
  <% if (isAdmin) { %><form method="post" action="/shipments/<%= s.id %>/lock" class="lock-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="on" value="1"><button class="btn small">🔒 Lock again</button></form><% } %></div><% } %>
<% if (s.blocked_at) { %><div class="blockbar" role="alert"><span class="blockicon">🔒</span><div><b>On hold — file blocked</b><%= s.block_reason ? `: ${s.block_reason}` : '' %>
  <div class="small">by <%= T.blockedBy || 'staff' %> on <%= fmtDateTime(s.blocked_at) %> UTC · nobody can change the file until it is unblocked (Tools › Unblock)</div></div></div><% } %>
<% const cr = T.credit; if (cr && cr.hold) { %><div class="blockbar <%= cr.released ? 'released' : '' %>" role="alert"><span class="blockicon"><%= cr.released ? '⚠' : '⛔' %></span><div>
  <b><%= cr.released ? 'Credit hold — released for this file' : 'On hold — credit' %></b>: <%= cr.party %> · <%= cr.reason %>
  <div class="small"><%= cr.released ? 'An admin allowed the D/O for this file.' : 'D/O cannot be sent until the account is paid down or an admin releases this file.' %><% if (canAccounting) { %> Open A/R $<%= fmtNum(cr.open, 2) %><%= cr.limit ? ` / limit $${fmtNum(cr.limit, 0)}` : '' %><%= cr.overdue ? ` · past due $${fmtNum(cr.overdue, 2)}` : '' %>.<% } %></div></div>
  <% if (user.role === 'admin') { %><form method="post" action="/shipments/<%= s.id %>/credit-release" style="margin-left:auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="on" value="<%= cr.released ? '0' : '1' %>">
    <button class="btn small secondary" <%= cr.released ? '' : 'data-confirm="Release this file despite the credit hold?"' %>><%= cr.released ? 'Withdraw release' : 'Release this file' %></button></form><% } %></div><% } %>
<div class="filebar">
  <span class="fb-no mono"><%= S.isMisc(s) ? s.ref_no : `${s.mode === 'AIR' ? 'HAWB' : 'HB/L'} ${s.hbl_no || '—'}` %></span>
  <span class="fb-item">👥 CUSTOMER: <% if (s.customer_id) { %><a href="/companies/<%= s.customer_id %>" title="Open the party"><%= s.customer_name %></a><% } else { %><span class="muted">not set</span><% } %></span>
  <% if (cr && cr.over) { %><span class="fb-badge overdue" title="Open A/R above the credit limit">Over credit</span><% } %><% if (cr && cr.manual) { %><span class="fb-badge overdue" title="<%= cr.note || '' %>">Credit hold</span><% } %>
  <% (T.badges || []).forEach((b) => { %><span class="fb-badge <%= b.cls %>" title="<%= b.title %>"><%= b.label %><%= b.amount && canAccounting ? ` $${fmtNum(b.amount, 2)}` : '' %></span><% }) %>
  <% if (s.bill_to_id && s.bill_to_id !== s.customer_id) { %><span class="fb-item">BILL TO: <%= s.bill_to_name %></span><% } %>
  <span class="fb-item">SALES: <%= s.sales_name || '—' %></span>
  <span class="fb-item">OP: <%= s.owner_name || '—' %></span>
  <details class="tools">
    <summary class="btn small">Tools ▾</summary>
    <div class="tools-menu">
      <% if (isAdmin && !locked && !s.lock_released_at) { %><form method="post" action="/shipments/<%= s.id %>/lock"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="on" value="1">
        <button data-confirm="Lock this file? Nobody can change it or its invoices until an admin unlocks it." title="Accounting finished — freeze the file and its invoices">🔒 Lock (accounting done)</button></form><% } %>
      <% if (editOk) { %>
        <form method="post" action="/shipments/<%= s.id %>/block"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (s.blocked_at) { %><input type="hidden" name="on" value="0"><button>🔓 Unblock</button>
          <% } else { %><input type="hidden" name="on" value="1"><input name="reason" placeholder="Reason (e.g. bad credit)" class="small"><button>🔒 Block</button><% } %></form>
        <form method="post" action="/shipments/<%= s.id %>/copy"><input type="hidden" name="_csrf" value="<%= csrf %>"><button title="New file with the same parties and lane">⧉ Copy file</button></form>
        <% if (!S.isMisc(s) && (T.masters || []).length) { %><form method="post" action="/shipments/<%= s.id %>/move" class="tools-move"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <select name="master_id" required aria-label="Move to master"><option value="">Move to master…</option><% T.masters.forEach((m) => { %><option value="<%= m.id %>"><%= m.mbl_no || m.ref_no %><%= m.eta ? ` · ETA ${m.eta}` : '' %></option><% }) %></select>
          <button data-confirm="Move this house to the chosen master? Its carrier leg (MB/L, vessel, dates) will follow that master.">↪ Move</button></form><% } %>
      <% } %>
      <% if (!S.isMisc(s)) { %>
        <div class="tools-head">Documents</div>
        <% [['AN', 'Arrival notice'], ['DO', 'Delivery order'], ['ATME', 'Authority to make entry']].forEach(([t, l]) => { %><a href="/shipments/<%= s.id %>/doc/<%= t %>"><%= l %></a><% }) %>
        <% if (can('send_notices')) { %><div class="tools-head">Email</div>
          <a href="/shipments/<%= s.id %>/email/AN">✉ A/N &amp; documents → broker</a>
          <a href="/shipments/<%= s.id %>/email/DO">✉ D/O → trucker</a>
          <a href="/shipments/<%= s.id %>/email/UPDATE">✉ Status update → customer</a>
          <a href="/shipments/<%= s.id %>/email/BLANK">✉ New email…</a><% } %>
        <a href="/shipments/<%= s.id %>?view=customer">👁 View as customer</a>
      <% } %>
    </div>
  </details>
</div>
<div class="pagehead">
  <div>
    <h1 style="margin-bottom:4px"><%= S.fileName(s) %> <span class="muted" style="font-weight:400">· <%= S.MODES[s.mode].icon %> <%= S.MODES[s.mode].label %></span></h1>
    <div class="muted small" style="margin-bottom:6px;display:flex;align-items:center;gap:6px;flex-wrap:wrap">Ref. <span class="ref-chip mono" title="System reference of this file"><%= s.ref_no %></span>
      <button type="button" class="btn secondary small" data-copy="<%= s.ref_no %>" title="Copy">⧉</button>
      <% if (s.master_id) { %> · Master <a class="mono" href="/masters/<%= s.master_id %>"><%= s.mbl_no || 'MB/L' %></a><% } %><%= s.customer_name ? ` · ${s.customer_name}` : '' %></div>
    <div class="chips">
      <% if (s.closed_at) { %><span class="badge closed">Closed <%= fmtDate(s.closed_at) %> · in history</span><% } %>
      <% if (billing && !s.closed_at) { %><span class="badge bill-<%= billing.level %>"><%= billing.label %></span><% } %>
      <% if (!S.isMisc(s)) { %><span class="badge <%= s.status %>"><%= S.statusLabel(s.status) %></span>
      <span class="badge <%= s.customs_status %>">Customs: <%= s.customs_status %></span><% } %>
      <% if (s.an_sent_at) { %><span class="badge SENT">A/N sent <%= fmtDate(s.an_sent_at) %></span><% } %>
      <% if (s.do_sent_at) { %><span class="badge SENT">D/O sent <%= fmtDate(s.do_sent_at) %></span><% } %>
      <% if (s.holds) { %><span class="badge EXAM">Hold: <%= s.holds %></span><% } %>
      <% const lfd = S.lfdInfo(s); if (lfd) { %><span class="badge lfd-<%= lfd.level %>">LFD <%= lfd.date %></span><% } %>
    </div>
  </div>
  <div class="actions">
    <% if (!S.isMisc(s)) { %><a class="btn secondary" href="/shipments/<%= s.id %>?view=customer">View as customer</a><% } %>
  </div>
</div>

<div class="card next-actions <%= nextActions.length ? '' : 'clear' %>">
  <h2 style="margin-bottom:4px"><%= nextActions.length ? `Next actions (${nextActions.length})` : '✔ Nothing pending on this file' %>
    <span class="muted small" style="font-weight:400"> · PIC: <a href="#pic"><%= s.owner_name || 'not assigned' %></a></span></h2>
  <% nextActions.forEach((i) => { %><%- include('../partials/fu-item', { i, back: `/shipments/${s.id}`, showFile: false }) %><% }) %>
  <details class="addtask"><summary class="small">＋ Add a task for this file</summary>
    <form method="post" action="/tasks" class="taskform"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="shipment_id" value="<%= s.id %>"><input type="hidden" name="back" value="/shipments/<%= s.id %>">
      <input name="title" required placeholder="e.g. Customer will pay Friday — release D/O then" maxlength="200">
      <select name="assignee_id" aria-label="Assignee"><% (locals.staffUsers || []).forEach((u) => { %><option value="<%= u.id %>" <%= u.id === (s.owner_id || user.id) ? 'selected' : '' %>><%= u.name %></option><% }) %></select>
      <input type="date" name="due_date" aria-label="Due date"><button class="btn small">Add task</button></form></details>
</div>

<% const misc = S.isMisc(s); if (misc) { %><div class="card small muted">📁 <b>Other file</b> — holds invoices that belong to no shipment. Add A/R, A/P, D/N and C/N below; the file shows their profit and appears in P/L, SOA and aging like any file. Close it from the file list when you no longer use it.</div><% } else { %>
<div class="card">
  <%- include('../partials/trackbar', { s, tr, big: true }) %>
  <%- include('../partials/steps', { tr }) %>
</div>

<div class="card" id="tracking">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
    <h2 style="margin:0">Carrier / GPS tracking</h2>
    <form method="post" action="/shipments/<%= s.id %>/track"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn secondary small" <%= trackingStatus.any ? '' : 'disabled title="No tracking provider configured — see Automation"' %>>↻ Refresh tracking now</button></form>
  </div>
  <dl class="trackinfo" style="margin:10px 0 0">
    <dt>Source</dt><dd><%= s.tracking_provider ? { terminal49: 'Terminal49', shipsgo: 'ShipsGo', dcsa: `Carrier API (${s.scac || ''})` }[s.tracking_provider] : (trackingStatus.any ? 'Not registered yet' : 'No provider configured') %>
      <% if (s.tracking_status) { %><span class="badge <%= ['error','failed'].includes(s.tracking_status) ? 'FAILED' : s.tracking_status === 'tracking' ? 'SENT' : '' %>"><%= s.tracking_status %></span><% } %>
      <% if (s.tracking_enabled === 0) { %><span class="badge">auto-tracking off</span><% } %></dd>
    <% if (s.tracking_error) { %><dt>Message</dt><dd class="small"><%= s.tracking_error %></dd><% } %>
    <dt>Last checked</dt><dd><%= s.tracking_checked_at ? `${fmtDateTime(s.tracking_checked_at)} UTC` : '—' %></dd>
    <% if (s.original_eta && s.original_eta !== s.eta) { %><dt>Original ETA</dt><dd><%= s.original_eta %> → now <b><%= s.eta %></b></dd><% } %>
    <% if (s.vessel_imo) { %><dt>Vessel IMO</dt><dd class="mono"><%= s.vessel_imo %><%= s.vessel_mmsi ? ` · MMSI ${s.vessel_mmsi}` : '' %></dd><% } %>
  </dl>
  <%- include('../partials/vesselmap', { s }) %>
  <% if (trackEvents.length) { %>
    <details style="margin-top:10px"><summary class="small"><b><%= trackEvents.length %> carrier events</b></summary>
      <table class="t small" style="margin-top:6px"><% trackEvents.forEach((e) => { %><tr><td class="nowrap"><%= fmtDateTime(e.event_time) %></td><td><%= e.event %></td><td class="mono"><%= e.container_no || '' %></td><td><%= e.location || '' %></td><td><%= e.vessel || '' %> <%= e.voyage || '' %></td></tr><% }) %></table>
    </details>
  <% } %>
</div>

<% } %>
<% if (can('send_notices') && !misc) { %><div class="card">
  <h2>Notices</h2>
  <div class="actions">
    <a class="btn" href="/shipments/<%= s.id %>/email/AN">✉ A/N &amp; docs → broker</a>
    <a class="btn" href="/shipments/<%= s.id %>/email/DO">✉ D/O → trucker</a>
    <a class="btn" href="/shipments/<%= s.id %>/email/UPDATE">✉ Status update → customer</a>
    <a class="btn secondary" href="/shipments/<%= s.id %>/email/BLANK">✉ New email</a>
    <% ['AN', 'DO', 'ATME'].forEach((t) => { const label = { AN: 'A/N', DO: 'D/O', ATME: 'ATME' }[t]; %>
      <a class="btn secondary" href="/shipments/<%= s.id %>/doc/<%= t %>">📄 <%= label %></a>
    <% }) %>
  </div>
  <p class="muted small" style="margin:8px 0 0">Each button opens the send window: check the recipients (To / CC / BCC), attachments, subject and text, then send. It goes from our mailbox and a copy stays on the file. Automatic sending rules are in Automation settings.</p>
</div><% } %>

<% if (canAccounting) { const m = (v) => fmtNum(v, 2); %>
<div class="card" id="accounting">
  <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
    <h2 style="margin:0">Accounting — profit / loss for this file</h2>
    <div class="actions">
      <% if (locked) { %><span class="badge paid">🔒 Locked</span><% } else { %>
      <a class="btn secondary small" href="/invoices/new?kind=AR&shipment=<%= s.id %>">Full AR invoice form</a>
      <a class="btn secondary small" href="/invoices/new?kind=DN&shipment=<%= s.id %>">Full D/N form</a>
      <form method="post" action="/shipments/<%= s.id %>/close"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="closed" value="<%= s.closed_at ? '0' : '1' %>">
        <button class="btn secondary small" data-confirm="<%= s.closed_at ? 'Reopen this file?' : 'Close this file and move it to Shipment history?' %>"><%= s.closed_at ? '↺ Reopen file' : '✔ Close file' %></button></form><% } %>
    </div>
  </div>
  <div class="pl-tiles" style="margin-top:12px">
    <div><span>Revenue (AR + D/N)</span><b><%= m(profit.revenue) %></b></div>
    <div><span>Cost (vendor bills + agent credit)</span><b><%= m(profit.cost) %></b></div>
    <div><span>Profit</span><b style="color:<%= profit.profit >= 0 ? 'var(--green)' : 'var(--red)' %>"><%= m(profit.profit) %></b></div>
    <div><span>Margin</span><b><%= profit.margin != null ? `${profit.margin}%` : '—' %></b></div>
  </div>
  <% if (plLines.length) { %>
  <div class="tablewrap"><table class="t small">
    <thead><tr><th>Invoice</th><th>Party</th><th>Item</th><th class="right">Revenue</th><th class="right">Cost</th><th>Status</th></tr></thead>
    <% let last = null; plLines.forEach((l) => { const first = l.invoice_id !== last; last = l.invoice_id; %>
      <tr class="<%= first ? '' : 'sub' %>">
        <td class="nowrap"><% if (first) { %><a href="/invoices/<%= l.invoice_id %>"><b><%= l.number %></b></a> <span class="muted"><%= { AR: 'AR', DN: l.invoice_total < 0 ? 'C/N' : 'D/N', AP: 'Vendor' }[l.kind] %></span><% } %></td>
        <td><%= first ? (l.company_name || '') : '' %></td>
        <td><%= l.description %><%= l.rate != null && l.qty != null ? ` (${fmtNum(l.rate, 2)} × ${l.qty})` : '' %></td>
        <td class="right"><%= l.revenue ? m(l.revenue) : '' %></td><td class="right"><%= l.cost ? m(l.cost) : '' %></td>
        <td class="nowrap"><% if (first) { %><span class="badge <%= l.status === 'PAID' ? 'paid' : 'unpaid' %>"><%= l.status %></span><%= l.status === 'OPEN' && l.paid_amount ? ` ${m(l.paid_amount)} paid` : '' %><%= l.kind !== 'AP' && l.status === 'OPEN' && !l.sent_at ? ' · not sent' : '' %><% } %></td>
      </tr>
    <% }) %>
    <tr><td colspan="3" class="right"><b>Total</b></td><td class="right"><b><%= m(profit.revenue) %></b></td><td class="right"><b><%= m(profit.cost) %></b></td><td></td></tr>
  </table></div>
  <% } else { %><p class="muted small">No invoices or vendor bills on this file yet — add them below.</p><% } %>

  <div class="vendor-drop">
    <form method="post" action="/vendor-bills/upload?_csrf=<%= csrf %>" enctype="multipart/form-data" data-drop data-autosubmit>
      <input type="hidden" name="shipment_id" value="<%= s.id %>"><input type="hidden" name="back" value="/shipments/<%= s.id %>#accounting">
      <label class="drop-hint" style="padding:6px 4px"><span class="ico">📎</span>
        <span><b>Vendor / CFS invoice</b> — drag the PDF or the Outlook email here, or <span class="pick">choose file</span><br>
          <span class="muted small">Invoice no., date, terms and charge lines are filled in for you.</span> <span data-drop-files></span></span>
        <input type="file" name="files" multiple accept=".pdf,.jpg,.jpeg,.png,.msg,.eml"></label>
    </form>
    <% if (vendorPending.length) { %><div class="pending-list"><% vendorPending.forEach((d) => { const ex = d.ex || {}; %>
      <a class="pending" href="/vendor-bills/<%= d.id %>">⏳ <b><%= d.vendor_name || 'Vendor ?' %></b> <%= ex.number ? `#${ex.number}` : '' %> <%= ex.total != null ? `USD ${fmtNum(ex.total, 2)}` : '' %> — review &amp; book →</a>
    <% }) %></div><% } %>
  </div>

  <% if (outgoing.length) { const ready = outgoing.filter((i) => i.reviewed_at && !i.sent_at && i.status === 'OPEN').length; %>
  <form method="post" action="/shipments/<%= s.id %>/invoices/review" class="review-box">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="review-head"><h3>Review &amp; send to parties</h3>
      <span class="muted small">Tick <b>Reviewed</b> once an invoice / D/N / C/N is checked. Only reviewed items are emailed<%= autoSend ? ' — automatic sending is ON (Automation)' : '' %>.</span></div>
    <table class="t small">
      <thead><tr><th class="c" style="width:80px">Reviewed</th><th>Document</th><th>To</th><th class="right">Amount</th><th>State</th></tr></thead>
      <% outgoing.forEach((i) => { const label = i.kind === 'AR' ? 'Invoice' : i.total < 0 ? 'Credit note' : 'Debit note'; %>
        <tr class="<%= i.reviewed_at ? 'is-reviewed' : '' %>">
          <td class="c"><input type="checkbox" class="big" name="reviewed" value="<%= i.id %>" <%= i.reviewed_at ? 'checked' : '' %> <%= i.sent_at ? 'disabled' : '' %> aria-label="Reviewed <%= i.number %>"></td>
          <td><a href="/invoices/<%= i.id %>"><b><%= i.number %></b></a> <span class="muted"><%= label %></span> · <a href="/invoices/<%= i.id %>/preview" target="_blank">preview</a></td>
          <td><%= i.company_name || '' %><br><span class="<%= i.to.length ? 'muted' : 'late' %> small"><%= i.to.length ? i.to.join(', ') : 'no billing email — add on Parties' %></span></td>
          <td class="right nowrap"><%= m(Math.abs(i.total)) %></td>
          <td class="nowrap"><% if (i.sent_at) { %><span class="state sent">✉ Sent <%= fmtDate(i.sent_at) %></span>
            <% } else if (i.reviewed_at) { %><span class="state ready">✔ Ready to send</span>
            <% } else { %><span class="state draft">Draft — review</span><% } %></td>
        </tr>
      <% }) %>
    </table>
    <div class="actions" style="margin-top:10px">
      <button class="btn secondary" name="send" value="0">Save review</button>
      <button class="btn" name="send" value="1" data-confirm="Save the review and email every reviewed, unsent item to its party?">✉ Save &amp; send reviewed to parties<%= ready ? ` (${ready} ready)` : '' %></button>
    </div>
  </form>
  <% } %>

  <% if (!locked) { %><details <%= plLines.length ? '' : 'open' %> style="margin-top:12px"><summary><b>+ Add invoice / vendor bill to this file</b></summary>
  <form method="post" action="/shipments/<%= s.id %>/accounting" style="margin-top:10px">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid g4">
      <div class="field"><label>Type</label>
        <select name="kind" data-kind-select data-ar="<%= S.guessCustomer(s) || '' %>" data-dn="<%= s.agent_id || '' %>" data-ap="<%= s.trucker_id || '' %>">
          <option value="AP">Vendor bill (cost) — trucker, broker, warehouse, carrier…</option>
          <option value="AR">AR invoice to customer (revenue)</option>
          <option value="DN">D/N to agent (revenue; negative = credit)</option>
        </select></div>
      <div class="field"><label>Party</label>
        <select name="company_id" required data-party-search><option value="">— pick —</option>
          <%- include('../partials/party-options', { parties: acctParties, selected: null, prefer: ['customer', 'agent', 'vendor', 'trucker', 'broker'] }) %></select>
        <span class="muted small">Customer: <%= s.customer_name || '—' %> · Agent: <%= s.agent_name || '—' %> · Trucker: <%= s.trucker_name || '—' %> · Broker: <%= s.broker_name || '—' %></span></div>
      <div class="field"><label>Vendor invoice no. <span class="muted">(bills only — ours are numbered automatically)</span></label><input name="number" placeholder="e.g. CTC-7781" data-dup-check></div>
      <div class="field"><label>Invoice date</label><input type="date" name="invoice_date" value="<%= new Date().toISOString().slice(0, 10) %>"></div>
      <div class="field"><label>Terms (days)</label><input type="number" name="terms_days" placeholder="party default"></div>
      <div class="field" style="grid-column: span 3"><label>Memo</label><input name="memo" placeholder="e.g. IPSY DELIVERY - 133 PLTS"></div>
    </div>
    <div class="tablewrap"><table class="t lines" data-lines="acct">
      <thead><tr><th style="min-width:240px">Item</th><th>Rate</th><th>Qty</th><th>Amount</th><th></th></tr></thead>
      <tbody><% [0, 1, 2].forEach(() => { %><tr>
        <td><input name="l_desc" list="charge-codes"></td><td><input name="l_rate" style="width:100px"></td><td><input name="l_qty" style="width:60px"></td>
        <td><input name="l_amount" placeholder="= rate × qty" style="width:120px"></td><td><button type="button" class="btn secondary small" data-remove-row>✕</button></td></tr><% }) %></tbody>
    </table></div>
    <datalist id="charge-codes"><% codes.forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
    <div class="actions" style="margin-top:8px"><button type="button" class="btn secondary small" data-add-row="acct">+ Line</button><button class="btn">Save to this file</button></div>
  </form></details><% } %>
</div>
<% } %>

<div class="grid" style="grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr); align-items: start">
  <form method="post" action="/shipments/<%= s.id %>">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <fieldset class="plainset" <%= locked ? 'disabled' : '' %>>
    <%- include('../partials/fields', { s }) %>
    </fieldset>
    <% if (locked) { %><p class="muted small">🔒 Locked — view only<%= isAdmin ? '. Unlock at the top of the page to make a change.' : '. Ask an admin to unlock it.' %></p><% } else if (can('shipments_edit')) { %><div class="actions"><button class="btn">Save changes</button></div><% } else { %><p class="muted small">View only — you do not have the "Create / edit shipments" permission.</p><% } %>
  </form>

  <div>
    <% if (!misc) { %><div class="card"><h2>Clearance & release</h2><%- include('../partials/checklist', { s }) %></div><% } %>
    <div class="card" id="docs">
      <h2>Documents</h2>
      <% if (!docs.length) { %><p class="muted small">No documents yet.</p><% } %>
      <% const edit = can('shipments_edit'); const dups = docs.filter((d) => d.duplicate_of).length; %>
      <% if (docs.length) { %><form method="post" action="/documents/delete" data-bulk>
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="shipment_id" value="<%= s.id %>">
        <% if (edit) { %><div class="actions" style="margin-bottom:6px;align-items:center">
          <label class="check small"><input type="checkbox" data-bulk-all> All</label>
          <% if (dups) { %><button type="button" class="btn secondary small" data-check-dups>Select <%= dups %> duplicate<%= dups === 1 ? '' : 's' %></button><% } %>
          <button class="btn danger small" data-bulk-btn disabled data-confirm="Delete the checked documents?">🗑 Delete (<span data-bulk-count>0</span>)</button></div><% } %>
      <table class="t docs-table">
        <% docs.forEach((d) => { %>
          <tr class="<%= d.duplicate_of ? 'dup' : '' %>">
            <% if (edit) { %><td style="width:22px"><% if (!d.from_master) { %><input type="checkbox" name="doc_ids" value="<%= d.id %>" data-bulk-item <%= d.duplicate_of ? 'data-dup' : '' %>><% } %></td><% } %>
            <td><% if (edit) { %><select class="doc-type" data-doc-type="<%= d.id %>" title="Change document type"><% [...new Set([d.doc_type, 'MBL', 'HBL', 'PL', 'CI', 'ISF', 'AWB', 'NOA', 'AN', 'DO', 'ATME', 'OTHER'])].forEach((t) => { %><option <%= t === d.doc_type ? 'selected' : '' %>><%= t %></option><% }) %></select><% } else { %><span class="badge"><%= d.doc_type %></span><% } %></td>
            <td><a href="/documents/<%= d.id %>" target="_blank"><%= d.filename %></a><br><span class="muted small"><%= d.source %> · <%= fmtDateTime(d.created_at) %></span>
              <% if (d.duplicate_of) { %><span class="badge EXAM" title="Same file already on this file">duplicate</span><% } %>
              <% if (d.from_master) { %><a class="badge" href="/masters/<%= s.master_id %>" title="On the master B/L">master</a><% } %></td>
            <td class="nowrap">
              <button class="btn secondary small" formaction="/documents/<%= d.id %>/visibility" title="Toggle customer visibility"><%= d.customer_visible ? '👁 Customer' : 'Internal' %></button>
              <% if (edit && !d.from_master) { %><button class="btn secondary small" name="one" value="<%= d.id %>" title="Delete" data-confirm="Delete <%= d.filename %>?">🗑</button><% } %>
            </td>
          </tr>
        <% }) %>
      </table></form><% } %>
<% if (can('shipments_edit')) { %>      <form method="post" action="/shipments/<%= s.id %>/documents?_csrf=<%= csrf %>" enctype="multipart/form-data" style="margin-top:12px" class="dropzone" data-drop>
        <div class="grid g2" style="gap:8px">
          <select name="doc_type"><% ['MBL','HBL','PL','CI','ISF','AWB','AN','DO','ATME','OTHER'].forEach((t) => { %><option value="<%= t %>"><%= { PL: 'PL (lines added to P/L table)', CI: 'CI (lines added if no P/L)' }[t] || t %></option><% }) %><option value="CIPL">C/I + P/L in one file (lines added)</option><option value="VINV">Vendor / CFS invoice → accounting (auto-read)</option></select>
          <label class="check"><input type="checkbox" name="customer_visible" value="1"> Visible to customer</label>
        </div>
        <input type="file" name="files" multiple style="margin:8px 0">
        <div class="muted small" style="margin-bottom:6px">…or drag files / the Outlook email here. <span data-drop-files></span></div>
        <button class="btn secondary small">Upload</button>
      </form><% } %>
    </div>

    <div class="card" id="memos">
      <h2>Memo</h2>
      <form method="post" action="/shipments/<%= s.id %>/memos" class="memo-form"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <input name="subject" placeholder="Subject (e.g. customer asked for Friday delivery)" maxlength="200">
        <textarea name="body" rows="2" placeholder="Details — visible to staff only"></textarea>
        <button class="btn secondary small">＋ Add memo</button></form>
      <% if (!(T.memos || []).length) { %><p class="muted small" style="margin:6px 0 0">No memos yet.</p><% } %>
      <ul class="memos"><% (T.memos || []).forEach((m) => { %><li>
        <div><b><%= m.subject || '(no subject)' %></b><% if (m.user_id === user.id || user.role === 'admin') { %>
          <form method="post" action="/memos/<%= m.id %>/delete" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn" title="Delete memo" data-confirm="Delete this memo?">✕</button></form><% } %></div>
        <% if (m.body) { %><div class="small" style="white-space:pre-line"><%= m.body %></div><% } %>
        <div class="when"><%= m.user_name || '' %> · <%= fmtDateTime(m.created_at) %> UTC</div></li><% }) %></ul>
    </div>

    <div class="card" id="emails">
      <h2>Emails</h2>
      <% if (!emails.length) { %><p class="muted small">Nothing sent yet.</p><% } %>
      <ul class="timeline">
        <% emails.forEach((e) => { %>
          <li><a href="/outbox/<%= e.id %>"><%= e.kind.replace('_', ' ') %></a> <span class="badge <%= e.status %>"><%= e.status %></span><br>
            <span class="small">to <%= e.to_addr %></span><br><span class="when"><%= fmtDateTime(e.created_at) %> UTC</span></li>
        <% }) %>
      </ul>
    </div>

    <div class="card">
      <h2>History</h2>
      <ul class="timeline">
        <% events.forEach((e) => { %>
          <li><%= e.message %><% if (!e.customer_visible) { %> <span class="muted small">(internal)</span><% } %><br><span class="when"><%= fmtDateTime(e.created_at) %> UTC</span></li>
        <% }) %>
      </ul>
    </div>

    <% if (can('delete')) { %>
      <form method="post" action="/shipments/<%= s.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn danger small" data-confirm="Delete shipment <%= S.fileName(s) %> (<%= s.ref_no %>) and all its documents? This cannot be undone.">Delete shipment</button></form>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
