<%- include('../partials/head') %>
<% if (config.mailTransport === 'log') { %><div class="flash err">Email sending is not set up yet — this message will only be saved in the Outbox. <% if (can('settings')) { %><a href="/admin/email-setup">Connect the mailbox</a><% } else { %>Ask an admin to connect the mailbox (Administration › Email setup).<% } %></div><% } %>
<% const s = d.s; const NAMES = { AN: 'Arrival notice', DO: 'Delivery order', ATME: 'Authority to make entry' }; %>
<div class="pagehead"><div><h1 style="margin-bottom:4px">Send email</h1><div class="muted small"><%= d.label %> · <a href="/shipments/<%= s.id %>" target="_self"><%= S.fileName(s) %></a> (<%= s.ref_no %>)</div></div>
  <a class="btn secondary" href="/shipments/<%= s.id %>" target="_self" title="Back in this tab — what you typed here is kept until you send">← Back to the file</a></div>
<div class="infobox small" id="draft-note" hidden>↺ Your unsent email was restored. <button type="button" class="linkbtn" id="draft-reset">Start over</button></div>
<% if (d.partyMissing) { %><div class="warnbox">No <%= { AN: 'customs broker', DO: 'trucker' }[d.kind] || 'customer' %> on this file yet — type the address below, or set the party on the file first.</div><% } %>
<form class="card compose" method="post" action="/shipments/<%= s.id %>/email/<%= d.kind %>?_csrf=<%= csrf %>" enctype="multipart/form-data" id="compose">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <datalist id="addr-suggest"><% d.suggestions.forEach((a) => { %><option value="<%= a %>"><% }) %></datalist>
  <div class="crow"><label>From</label><div class="cfield muted"><%= mailbox || 'Email sending not set up — the message is kept in the Outbox' %></div></div>
  <div class="crow"><label for="reply_to">Reply to</label><div class="cfield"><input id="reply_to" name="reply_to" list="addr-suggest" placeholder="Optional — where replies should go" value="<%= me.email || '' %>"></div></div>
  <% if (d.remembered) { %><div class="infobox small">✉ Recipients filled from the last <%= d.remembered.kind === 'DO' ? 'D/O to' : 'A/N for' %> <b><%= d.remembered.who %></b> (<a href="/shipments/<%= d.remembered.id %>" target="_blank"><%= d.remembered.ref_no %></a>, <%= fmtDate(d.remembered.date) %>) — change them if needed; what you send now is remembered for this <%= d.remembered.kind === 'DO' ? 'trucker' : 'shipper' %>.</div><% } %>
  <% if (d.greeting) { %><div class="muted small" style="margin:-4px 0 8px 120px">“Dear <%= d.greeting %>” — as in your last email to these recipients.</div><% } %>
  <% [['to', 'To', d.to], ['cc', 'CC', d.cc], ['bcc', 'BCC', d.bcc || []]].forEach(([k, label, list]) => { %>
  <div class="crow"><label><%= label %></label><div class="cfield chips-input" data-chips="<%= k %>">
    <% list.forEach((a) => { %><span class="chip" data-v="<%= a %>"><%= a %><button type="button" aria-label="Remove <%= a %>">×</button></span><% }) %>
    <input list="addr-suggest" placeholder="Add email address here… (Enter)" aria-label="<%= label %> address">
    <input type="hidden" name="<%= k %>" value="<%= list.join(', ') %>"></div></div>
  <% }) %>
  <div class="crow"><label></label><div class="cfield"><label class="check small"><input type="checkbox" name="include_me" value="1"> Include myself (CC <%= me.email || 'me' %>)</label>
    <% if (d.suggestions.length) { %><span class="muted small"> · suggestions from this file's parties and earlier emails appear as you type</span><% } %></div></div>
  <div class="crow"><label>Attachment</label><div class="cfield">
    <% d.generate.forEach((t) => { %><label class="check small attach"><input type="checkbox" name="generate" value="<%= t %>" checked> 📄 <b><%= NAMES[t] %></b> — created now (PDF) <a href="/shipments/<%= s.id %>/doc/<%= t %>" data-preview="<%= NAMES[t] %>" <%- t === 'AN' ? 'data-an-preview' : '' %>>preview</a></label>
      <% if (t === 'AN') { %><label class="check small attach" style="margin-left:22px"><input type="checkbox" name="an_prices" value="1" data-an-prices> 💲 Show charges &amp; amount due on the A/N <span class="muted">(tick to include prices)</span></label><% } %><% }) %>
    <% d.docs.forEach((doc) => { %><label class="check small attach"><input type="checkbox" name="doc_ids" value="<%= doc.id %>" <%= doc.checked ? 'checked' : '' %>> <span class="badge"><%= doc.doc_type %></span> <%= doc.filename %></label><% }) %>
    <% if (!d.generate.length && !d.docs.length) { %><span class="muted small">No documents on the file.</span><% } %>
    <div style="margin-top:6px"><input type="file" name="files" multiple aria-label="Upload attachments"> <span class="muted small">Added files are also saved on the file.</span></div></div></div>
  <div class="crow"><label for="subject">Subject</label><div class="cfield"><input id="subject" name="subject" value="<%= d.subject %>" required>
    <div class="small subj-adds">Add to subject:
      <% [['File No.', s.ref_no], ['MB/L', s.mbl_no], ['HB/L', s.hbl_no], ['Customer', s.customer_name], ['PO', s.customer_ref], ['ETD', s.etd], ['ETA', s.eta]].filter(([, v]) => v).forEach(([l, v]) => { %>
        <label class="check"><input type="checkbox" data-subj="<%= v %>"> <%= l %></label><% }) %></div></div></div>
  <div class="crow"><label>Content</label><div class="cfield">
    <div class="rte-bar" role="toolbar" aria-label="Formatting">
      <button type="button" data-cmd="bold" title="Bold"><b>B</b></button><button type="button" data-cmd="italic" title="Italic"><i>I</i></button><button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
      <button type="button" data-cmd="insertUnorderedList" title="Bullets">• List</button><button type="button" data-cmd="insertOrderedList" title="Numbers">1. List</button></div>
    <div class="rte" contenteditable="true" id="body" aria-label="Email text"><%- d.html %></div>
    <textarea name="html" hidden></textarea></div></div>
  <div class="actions" style="justify-content:flex-end"><a class="btn secondary" href="/shipments/<%= s.id %>" target="_self" data-discard>Cancel</a><button class="btn">✉ Send</button></div>
</form>
<dialog class="preview-dlg" id="preview-dlg" aria-label="Preview">
  <div class="preview-bar"><b id="preview-title">Preview</b>
    <button type="button" class="btn secondary small" id="preview-print">🖨 Print</button>
    <button type="button" class="btn small" id="preview-close">✕ Close</button></div>
  <iframe id="preview-frame" title="Document preview"></iframe>
</dialog>
<script>
(() => {
  const ok = (v) => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v);
  document.querySelectorAll('[data-chips]').forEach((box) => {
    const input = box.querySelector('input[list]'); const hidden = box.querySelector('input[type=hidden]');
    const sync = () => { hidden.value = [...box.querySelectorAll('.chip')].map((c) => c.dataset.v).join(', '); };
    const add = (raw) => { for (const v of String(raw).split(/[,;\s]+/).map((x) => x.trim().toLowerCase()).filter(Boolean)) {
      if (!ok(v) || [...box.querySelectorAll('.chip')].some((c) => c.dataset.v === v)) continue;
      const c = document.createElement('span'); c.className = 'chip'; c.dataset.v = v; c.textContent = v;
      const x = document.createElement('button'); x.type = 'button'; x.textContent = '×'; x.setAttribute('aria-label', `Remove ${v}`); c.append(x); box.insertBefore(c, input); }
      input.value = ''; sync(); };
    input.addEventListener('keydown', (e) => { if (['Enter', ',', ';', 'Tab'].includes(e.key) && input.value.trim()) { e.preventDefault(); add(input.value); }
      if (e.key === 'Backspace' && !input.value) { const last = [...box.querySelectorAll('.chip')].pop(); if (last) { last.remove(); sync(); } } });
    input.addEventListener('change', () => add(input.value)); input.addEventListener('blur', () => input.value.trim() && add(input.value));
    box.addEventListener('click', (e) => { if (e.target.matches('.chip button')) { e.target.parentElement.remove(); sync(); } else input.focus(); });
  });
  const subj = document.getElementById('subject');
  document.querySelectorAll('[data-subj]').forEach((c) => c.addEventListener('change', () => {
    const part = ` // ${c.dataset.subj}`;
    subj.value = c.checked ? subj.value + part : subj.value.replace(part, '');
  }));
  document.querySelectorAll('[data-cmd]').forEach((b) => b.addEventListener('click', () => { document.execCommand(b.dataset.cmd); document.getElementById('body').focus(); }));
  // Preview over this page (no new browser tab, nothing typed here is lost).
  const dlg = document.getElementById('preview-dlg'); const frame = document.getElementById('preview-frame');
  document.addEventListener('click', (e) => {
    const a = e.target.closest('a[data-preview]');
    if (!a) return;
    e.preventDefault();
    frame.src = a.getAttribute('href').replace('/doc/', '/preview/');
    document.getElementById('preview-title').textContent = `Preview — ${a.dataset.preview}`;
    dlg.showModal();
  });
  document.getElementById('preview-close').addEventListener('click', () => { dlg.close(); frame.src = 'about:blank'; });
  document.getElementById('preview-print').addEventListener('click', () => { try { frame.contentWindow.print(); } catch (err) { /* not loaded */ } });
  dlg.addEventListener('click', (e) => { if (e.target === dlg) { dlg.close(); frame.src = 'about:blank'; } });

  // Unsent draft: kept while you look at the file and come back (this browser tab only), cleared when sent.
  const form = document.getElementById('compose');
  const KEY = `gb.draft.<%= s.id %>.<%= d.kind %>`;
  const store = { get: () => { try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch (err) { return null; } },
    set: (v) => { try { sessionStorage.setItem(KEY, JSON.stringify(v)); } catch (err) { /* storage off */ } },
    clear: () => { try { sessionStorage.removeItem(KEY); } catch (err) { /* storage off */ } } };
  const snap = () => ({
    chips: Object.fromEntries([...document.querySelectorAll('[data-chips]')].map((b) => [b.dataset.chips, [...b.querySelectorAll('.chip')].map((c) => c.dataset.v)])),
    reply_to: form.reply_to.value, subject: subj.value, body: document.getElementById('body').innerHTML,
    checks: Object.fromEntries([...form.querySelectorAll('input[type=checkbox][name]')].map((c) => [`${c.name}:${c.value}`, c.checked])),
  });
  const first = JSON.stringify(snap());
  const saved = store.get();
  if (saved) {
    for (const [k, list] of Object.entries(saved.chips || {})) {
      const box = document.querySelector(`[data-chips="${k}"]`); if (!box) continue;
      box.querySelectorAll('.chip').forEach((c) => c.remove());
      const input = box.querySelector('input[list]'); input.value = list.join(', '); input.dispatchEvent(new Event('change'));
    }
    form.reply_to.value = saved.reply_to ?? form.reply_to.value; subj.value = saved.subject ?? subj.value;
    if (saved.body) document.getElementById('body').innerHTML = saved.body;
    form.querySelectorAll('input[type=checkbox][name]').forEach((c) => { const v = saved.checks?.[`${c.name}:${c.value}`]; if (v !== undefined && v !== c.checked) { c.checked = v; c.dispatchEvent(new Event('change', { bubbles: true })); } });
    document.getElementById('draft-note').hidden = false;
  }
  const keep = () => { const now = snap(); if (JSON.stringify(now) !== first || saved) store.set(now); };
  form.addEventListener('input', keep); form.addEventListener('change', keep); document.getElementById('body').addEventListener('input', keep);
  document.querySelectorAll('[data-chips]').forEach((b) => new MutationObserver(keep).observe(b, { childList: true }));
  document.getElementById('draft-reset').addEventListener('click', () => { store.clear(); location.reload(); });
  document.querySelector('[data-discard]').addEventListener('click', () => store.clear());

  document.getElementById('compose').addEventListener('submit', (e) => {
    document.querySelectorAll('[data-chips] input[list]').forEach((i) => { if (i.value.trim()) i.dispatchEvent(new Event('change')); });
    if (!document.querySelector('[name=to]').value) { e.preventDefault(); alert('Add at least one recipient in To'); return; }
    document.querySelector('[name=html]').value = document.getElementById('body').innerHTML;
    store.clear();
  });
})();
</script>
<%- include('../partials/foot') %>
