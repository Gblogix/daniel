<%- include('../partials/head') %>
<div class="pagehead">
  <div>
    <h1 style="margin-bottom:4px"><%= S.fileName(s) %> <span class="muted" style="font-weight:400">· <%= tr.mode.icon %> <%= tr.mode.label %></span></h1>
    <div class="muted small" style="margin-bottom:6px">Ref. <span class="mono"><%= s.ref_no %></span></div>
    <div class="chips"><span class="badge <%= s.status %>"><%= S.statusLabel(s.status) %></span><span class="badge <%= s.customs_status %>">Customs: <%= s.customs_status %></span>
      <% if (s.customs_status === 'EXAM') { %><span class="badge EXAM">Customs exam</span><% } %></div>
  </div>
  <div class="actions">
    <% if (isInternal) { %><a class="btn secondary" href="/shipments/<%= s.id %>">← Staff view</a><% } %>
    <a class="btn secondary" href="<%= user.role === 'customer' || isInternal ? '/track' : '/shipments' %>">All shipments</a>
  </div>
</div>

<% const step = S.customerStep(s); %>
<div class="card cstep-big"><span class="ico"><%= step.icon %></span><div><b><%= step.text %></b>
  <% if (s.delivery_request_at && !s.delivery_request_done) { %><div class="small muted">Your delivery request for <%= s.delivery_request_date %> <%= s.delivery_request_time || '' %> was received — we will confirm.</div><% } %></div></div>
<div class="card">
  <%- include('../partials/trackbar', { s, tr, big: true }) %>
  <%- include('../partials/steps', { tr }) %>
  <% if (s.original_eta && s.eta && s.original_eta !== s.eta) { %><p class="small" style="margin:10px 0 0">ETA updated by the carrier: <s><%= s.original_eta %></s> → <b><%= s.eta %></b></p><% } %>
  <% const hide = locals.portalHide || new Set(); if (!hide.has('vessel')) { %><%- include('../partials/vesselmap', { s }) %><% } %>
</div>
<% if (s.mode !== 'OTHER') { const ST = locals.stagesFor; const units = s.mode === 'FCL' && s.containers.length ? s.containers : [null]; %>
<div class="card"><h2>Journey</h2>
  <% units.forEach((c) => { const st = ST(s, c || {}); const list = st.list.filter((x) => !(hide.has('empty') && x.key === 'empty') && !(hide.has('lfd') && ['lfd', 'appt'].includes(x.key))); %>
    <div class="journey"><div class="j-head"><b class="mono"><%= c ? `${c.container_no}${c.size_type ? ' ' + c.size_type : ''}` : (s.hbl_no || s.ref_no) %></b> <span class="muted small"><%= st.current %></span></div>
      <ol class="j-steps"><% list.forEach((x) => { %><li class="<%= x.done ? 'done' : '' %>"><span class="j-dot"></span><span class="j-label"><%= x.label %></span><% if (x.date) { %><span class="j-date"><%= String(x.date).slice(0, 10) %></span><% } %></li><% }) %></ol></div>
  <% }) %>
</div><% } %>

<div class="grid g2" style="align-items:start">
  <div class="card">
    <h2>Shipment</h2>
    <table class="t">
      <tr><th>Shipper</th><td><%= s.shipper_name || '—' %></td></tr>
      <tr><th>Consignee</th><td><%= s.consignee_name || s.customer_name || '—' %></td></tr>
      <tr><th><%= s.mode === 'AIR' ? 'MAWB' : 'MBL' %></th><td class="mono"><%= s.mbl_no || '—' %></td></tr>
      <tr><th><%= s.mode === 'AIR' ? 'HAWB' : 'HBL' %></th><td class="mono"><%= s.hbl_no || '—' %></td></tr>
      <tr><th><%= s.mode === 'AIR' ? 'Flight' : 'Vessel / Voyage' %></th><td><%= s.mode === 'AIR' ? (s.flight_no || '—') : [s.vessel, s.voyage].filter(Boolean).join(' / ') || '—' %></td></tr>
      <tr><th>Route</th><td><%= s.pol || '?' %> → <%= s.pod || '?' %><%= s.place_of_delivery ? ` → ${s.place_of_delivery}` : '' %></td></tr>
      <tr><th>ETD / ETA</th><td><%= s.etd || 'TBA' %> / <b><%= s.eta || 'TBA' %></b></td></tr>
      <tr><th>Cargo</th><td><%= s.packages ? `${fmtNum(s.packages)} ${s.package_unit || ''}` : '—' %> · <%= s.weight_kg ? `${fmtNum(s.weight_kg, 2)} KG (${fmtNum(s.weight_kg * 2.20462, 2)} LBS)` : '—' %> · <%= s.cbm ? `${s.cbm} CBM (${fmtNum(s.cbm * 35.3147, 2)} FT³)` : '—' %></td></tr>
      <tr><th>A/N</th><td><%= s.an_sent_at ? `Issued ${fmtDate(s.an_sent_at)}` : 'Not yet issued' %></td></tr>
    </table>
  </div>
  <div class="card">
    <h2>Delivery</h2>
    <div class="deliv" style="font-size:14px">📍 <div><b><%= s.delivery_company_name || s.customer_name || 'Delivery' %></b><br><%= s.delivery_address || 'Address to be confirmed' %></div></div>
    <p style="font-size:16px;margin:14px 0 6px">🗓 <b><%= s.delivery_date || 'Date TBA' %></b> <%= s.delivery_time || '' %></p>
    <% if (s.cfs_location && !(locals.portalHide || new Set()).has('pickup')) { %><p class="muted small">Pick-up: <%= s.cfs_location %></p><% } %>
    <% if (s.status !== 'DELIVERED' && (user.role === 'customer')) { %>
    <form method="post" action="/shipments/<%= s.id %>/delivery-request" class="reqbox" id="request">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <b><%= s.delivery_date ? 'Need a different delivery date?' : 'Request a delivery date' %></b>
      <div class="grid g2" style="gap:8px;margin-top:6px">
        <div class="field" style="margin:0"><label>Date</label><input type="date" name="date" required value="<%= s.delivery_request_date || '' %>"></div>
        <div class="field" style="margin:0"><label>Time window</label><input name="time" placeholder="e.g. 9:00–12:00" value="<%= s.delivery_request_time || '' %>"></div>
      </div>
      <div class="field" style="margin:8px 0"><label>Notes (dock, contact, appointment no.)</label><input name="note" maxlength="500"></div>
      <button class="btn small">Send request</button>
    </form>
    <% } %>
    <h3 style="margin-top:18px">Containers</h3>
    <% if (!s.containers.length) { %><p class="muted small">Loose cargo / not assigned</p><% } %>
    <% s.containers.forEach((c) => { %><div class="mono"><%= c.container_no %> <span class="muted"><%= c.size_type || '' %> · seal <%= c.seal_no || '—' %></span></div><% }) %>
  </div>
</div>

<div class="card">
  <h2>What's inside (packing list)</h2>
  <% if (!s.items.length) { %><p class="muted small">Packing list details will appear once received.</p><% } else { %>
  <div class="tablewrap"><table class="t">
    <thead><tr><th>PO</th><th>Description</th><th class="right">Qty</th><th>Unit</th><th class="right">Pkgs</th><th class="right">KG</th><th class="right">LBS</th><th class="right">CBM</th><th class="right">FT³</th></tr></thead>
    <% s.items.forEach((i) => { %><tr><td><%= i.po_no || '' %></td><td><%= i.description %></td><td class="right"><%= fmtNum(i.quantity) %></td><td><%= i.unit || '' %></td><td class="right"><%= fmtNum(i.packages) %></td><td class="right"><%= fmtNum(i.weight_kg, 1) %></td><td class="right"><%= i.weight_kg != null ? fmtNum(i.weight_kg * 2.20462, 1) : '' %></td><td class="right"><%= i.cbm ?? '' %></td><td class="right"><%= i.cbm != null ? fmtNum(i.cbm * 35.3147, 2) : '' %></td></tr><% }) %>
  </table></div><% } %>
</div>

<div class="grid g2" style="align-items:start">
  <div class="card"><h2>Document info</h2>
    <% if (!docs.length) { %><p class="muted small">No documents shared yet.</p><% } else { const NAMES = { AN: 'Arrival notice', DO: 'Delivery order', HBL: 'House B/L', MBL: 'Master B/L', PL: 'Packing list', CI: 'Commercial invoice', ISF: 'ISF', AWB: 'Air waybill', ATME: 'Authority to make entry', POD: 'Proof of delivery' }; %>
    <div class="tablewrap"><table class="t"><thead><tr><th>Name</th><th>Type</th><th>Date</th><th>Action</th></tr></thead>
      <% docs.forEach((d) => { %><tr><td class="small"><%= d.filename %></td><td class="small"><%= NAMES[d.doc_type] || d.doc_type %></td><td class="nowrap small"><%= fmtDate(d.created_at) %></td>
        <td class="nowrap"><a class="btn secondary small" href="/documents/<%= d.id %>" target="_blank" title="View">👁</a> <a class="btn secondary small" href="/documents/<%= d.id %>?download" title="Download">⬇</a></td></tr><% }) %>
    </table></div><% } %>
  </div>
  <div class="card"><h2>Updates</h2>
    <ul class="timeline"><% events.forEach((e) => { %><li><%= e.message %><br><span class="when"><%= fmtDateTime(e.created_at) %> UTC</span></li><% }) %></ul>
  </div>
</div>
<%- include('../partials/foot') %>
