<%- include('partials/head') %>
<div class="pagehead"><div><h1 style="margin-bottom:4px">Follow-ups</h1>
  <p class="muted small" style="margin:0">Everything that needs someone, computed from the files — an item disappears by itself when the work is done.</p></div>
  <div class="chips"><span class="badge bill-bad"><%= counts.critical %> critical</span><span class="badge bill-warn"><%= counts.high %> high</span><span class="badge"><%= counts.total %> open</span></div>
</div>
<div class="filters">
  <div class="seg"><a class="<%= scope === 'mine' ? 'on' : '' %>" href="?scope=mine&area=<%= area %>">My files</a><a class="<%= scope === 'all' ? 'on' : '' %>" href="?scope=all&area=<%= area %>">Everyone</a></div>
  <div class="seg"><a class="<%= !area ? 'on' : '' %>" href="?scope=<%= scope %>">All</a><a class="<%= area === 'ops' ? 'on' : '' %>" href="?scope=<%= scope %>&area=ops">Operations</a>
    <% if (canAccounting) { %><a class="<%= area === 'acct' ? 'on' : '' %>" href="?scope=<%= scope %>&area=acct">Accounting</a><% } %></div>
  <a class="small" href="?scope=<%= scope %>&area=<%= area %>&hidden=<%= showHidden ? '' : '1' %>"><%= showHidden ? 'Hide snoozed / done' : 'Show snoozed / done' %></a>
</div>
<% const back = `/followups?scope=${scope}&area=${area}`; %>
<% groups.forEach(([name, list]) => { if (!list.length) return; %>
  <div class="card fu-group">
    <h2><%= name %> <span class="muted small">(<%= list.length %>)</span></h2>
    <% list.forEach((i) => { %><%- include('partials/fu-item', { i, back }) %><% }) %>
  </div>
<% }) %>
<% if (!groups.some(([, l]) => l.length)) { %><div class="card okbox">✔ Nothing waiting — all caught up.</div><% } %>
<%- include('partials/foot') %>
