<%- include('partials/head') %>
<div class="login card" style="max-width:420px">
  <span class="brand">GlobalBridge Logistics</span>
  <h2 style="margin:10px 0 4px">Change password</h2>
  <% if (forced) { %><p class="small" style="margin:0 0 10px">You signed in with a <b>temporary password</b>. Choose your own password to continue.</p>
  <% } else { %><p class="muted small" style="margin:0 0 10px">Signed in as <%= user.email %></p><% } %>
  <% if (error) { %><div class="flash err"><%= error %></div><% } %>
  <form method="post" action="/account/password" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="current"><%= forced ? 'Temporary password' : 'Current password' %></label><input id="current" name="current" type="password" required autofocus autocomplete="current-password"></div>
    <div class="field"><label for="password">New password <span class="muted small">(at least 8 characters)</span></label><input id="password" name="password" type="password" minlength="8" required autocomplete="new-password"></div>
    <div class="field"><label for="confirm">New password again</label><input id="confirm" name="confirm" type="password" minlength="8" required autocomplete="new-password"></div>
    <button class="btn" style="width:100%;justify-content:center">Save new password</button>
  </form>
  <% if (!forced) { %><p class="small" style="margin-top:12px;text-align:center"><a href="/">← Back</a></p><% } %>
</div>
<%- include('partials/foot') %>
