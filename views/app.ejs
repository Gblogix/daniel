<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GB Logix · GlobalBridge Logistics</title>
<link rel="stylesheet" href="/css/app.css?v=<%= v %>">
</head>
<body class="shell">
<header class="shell-top">
  <button type="button" class="burger" id="burger" aria-label="Menu" aria-expanded="false">☰</button>
  <a class="brand" href="/app">GB Logix</a>
  <div class="gsearch"><input id="gsearch" type="search" placeholder="Search container, B/L, shipper, invoice…  ( / )" autocomplete="off" aria-label="Search">
    <div class="gresults" id="gresults" hidden></div></div>
  <nav class="favbar" id="favbar" aria-label="Favorites"></nav>
  <a class="bell" id="bell" href="/followups" title="My follow-ups">🔔<span id="bellcount" hidden></span></a>
  <div class="who">
    <span><%= user.name %></span>
    <span class="role-chip"><%= ROLES[user.role].label %></span>
    <form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Sign out</button></form>
  </div>
</header>

<aside class="drawer" id="drawer" aria-hidden="true">
  <ul class="cats">
    <% menu.forEach((m, i) => { %>
      <li><button type="button" class="cat <%= i === 0 ? 'on' : '' %>" data-cat="<%= m.key %>"><span class="ico"><%= m.icon %></span><%= m.label %><span class="chev">›</span></button></li>
    <% }) %>
  </ul>
  <% menu.forEach((m, i) => { %>
    <div class="flyout" data-panel="<%= m.key %>" <%= i === 0 ? '' : 'hidden' %>>
      <% m.cols.forEach((c) => { %><div class="col"><div class="head"><%= c.head %></div>
        <% c.items.forEach((it) => { %><div class="item">
          <a href="<%= it.href %>" data-open="<%= it.href %>" data-title="<%= it.label %>"><%= it.label %></a>
          <button type="button" class="star" data-star="<%= it.id %>" title="Add to / remove from favorites">☆</button>
        </div><% }) %>
      </div><% }) %>
    </div>
  <% }) %>
  <p class="hint">☆ = add to the favorites bar at the top</p>
</aside>
<div class="scrim" id="scrim" hidden></div>

<% const ICON = {"home": "<path d=\"M3 11l9-7 9 7\"/><path d=\"M5 10v10h14V10\"/>", "flag": "<path d=\"M5 21V4\"/><path d=\"M5 4h11l-2 4 2 4H5\"/>", "ship": "<path d=\"M3 17l2 4h14l2-4\"/><path d=\"M5 17V9h14v8\"/><path d=\"M9 9V5h6v4\"/><path d=\"M2 21c2 0 2-1 4-1s2 1 4 1 2-1 4-1 2 1 4 1 2-1 4-1\"/>", "plane": "<path d=\"M10 14l-7-3 1-2 8 1 5-6c1-1 3-1 3 1l-5 6 1 8-2 1-3-7-4 4v3l-2 1-1-4-4-1 1-2h3z\"/>", "truck": "<path d=\"M2 6h12v10H2z\"/><path d=\"M14 10h4l3 3v3h-7\"/><circle cx=\"6\" cy=\"18\" r=\"2\"/><circle cx=\"17\" cy=\"18\" r=\"2\"/>", "folder": "<path d=\"M3 6h6l2 2h10v11H3z\"/>", "doc": "<path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4\"/><path d=\"M9 12h6M9 16h6\"/>", "calc": "<rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"2\"/><path d=\"M8 7h8M8 11h2M12 11h2M16 11h0M8 15h2M12 15h2M8 18h2M12 18h4\"/>", "chart": "<path d=\"M4 20V4\"/><path d=\"M4 20h16\"/><path d=\"M8 16v-5M12 16V8M16 16v-8\"/>", "users": "<circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20c0-3 3-5 6-5s6 2 6 5\"/><circle cx=\"17\" cy=\"9\" r=\"2\"/><path d=\"M15 15c3 0 6 1 6 4\"/>", "gear": "<circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M5 5l2 2M17 17l2 2M5 19l2-2M17 7l2-2\"/>"}; %>
<nav class="rail" id="rail" aria-label="Work areas">
  <% rail.forEach((r) => { %>
    <div class="rail-item" data-rail="<%= r.key %>">
      <a class="rail-btn" href="<%= r.href || '#' %>" <%- r.href ? `data-open="${r.href}" data-title="${r.label}"` : '' %> aria-label="<%= r.label %>" title="<%= r.label %>">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- ICON[r.icon] || '' %></svg></a>
      <div class="rail-fly" role="menu">
        <div class="rail-title"><%= r.label %></div>
        <% if (r.href) { %><div class="rail-row"><a role="menuitem" href="<%= r.href %>" data-open="<%= r.href %>" data-title="<%= r.label %>">Open <%= r.label %></a><button type="button" class="star" data-star="<%= r.id %>" title="Add to / remove from favorites">☆</button></div><% } %>
        <% (r.groups || []).forEach((g) => { %><div class="rail-head"><%= g.head %></div>
          <% g.items.forEach((it) => { %><div class="rail-row"><a role="menuitem" href="<%= it.href %>" data-open="<%= it.href %>" data-title="<%= it.title %>"><%= it.label %></a><button type="button" class="star" data-star="<%= it.id %>" title="Add to / remove from favorites">☆</button></div><% }) %>
        <% }) %>
      </div>
    </div>
  <% }) %>
</nav>
<div class="workarea">
<div class="tabbar" id="tabbar" role="tablist"></div>
<div class="panes" id="panes"></div>
</div>

<script type="application/json" id="shell-data"><%- JSON.stringify({
  items: favItems,
  favorites, open, csrf, userId: user.id,
}).replace(/</g, '\\u003c') %></script>
<script src="/js/shell.js?v=<%= v %>"></script>
</body>
</html>
