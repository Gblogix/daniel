<%- include('../partials/head') %>
<div class="pagehead"><h1>Invoices</h1></div>
<div class="tablewrap"><table class="t">
  <thead><tr><th>Invoice</th><th>Date</th><th>Due</th><th>Shipment</th><th class="right">Amount</th><th class="right">Balance</th><th>Status</th></tr></thead>
  <% if (!rows.length) { %><tr><td colspan="7" class="muted">No invoices.</td></tr><% } %>
  <% rows.forEach((i) => { %><tr><td><a href="/invoices/<%= i.id %>" target="_blank"><%= i.number %></a></td><td><%= i.invoice_date %></td><td><%= i.due_date %></td>
    <td class="mono small"><%= i.hbl_no || i.mbl_no || '' %></td><td class="right"><%= fmtNum(i.total, 2) %></td><td class="right"><b><%= fmtNum(i.balance, 2) %></b></td>
    <td><span class="badge <%= i.status === 'PAID' ? 'paid' : 'unpaid' %>"><%= i.status %></span></td></tr><% }) %>
</table></div>
<%- include('../partials/foot') %>
