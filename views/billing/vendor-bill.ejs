<%- include('../partials/head') %>
<% const lines = ex.lines && ex.lines.length ? ex.lines : [{}]; const sid = d.shipment_id; %>
<div class="pagehead"><div><h1 style="margin-bottom:4px">Book vendor invoice</h1>
  <div class="muted small"><%= d.filename %> · received <%= fmtDateTime(d.created_at) %> · read by <%= ex.source === 'ai' ? 'AI + rules' : 'rules' %><%= ex.ocr ? ' (OCR)' : '' %></div></div>
  <div class="actions">
    <form method="post" action="/vendor-bills/<%= d.id %>/reread"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary">↻ Read again</button></form>
    <form method="post" action="/vendor-bills/<%= d.id %>/discard"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary" data-confirm="Not a vendor invoice — remove it from the queue?">Not an invoice</button></form>
  </div>
</div>
<div class="split">
  <div class="card flush docview"><iframe src="/documents/<%= d.id %>" title="Vendor invoice"></iframe></div>
  <form class="card" method="post" action="/vendor-bills/<%= d.id %>" data-bill>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% if ((ex.warnings || []).length) { %><div class="warnbox"><b>Please check</b><ul><% ex.warnings.forEach((w) => { %><li><%= w %></li><% }) %></ul></div>
    <% } else { %><div class="okbox">✔ Everything was read — check against the invoice and book.</div><% } %>
    <div class="grid g2">
      <div class="field"><label>Vendor</label><select name="company_id" required data-party-search data-new-party><option value="">— pick —</option>
        <% const nv = !d.company_id && !ex.vendor && ex.vendor_new; if (nv) { %><option value="new" selected>＋ New vendor from the invoice: <%= nv.name %></option><% } %>
        <%- include('../partials/party-options', { parties, selected: d.company_id || ex.vendor?.id, prefer: ['vendor', 'trucker', 'broker', 'delivery', 'agent'] }) %></select>
        <% if (nv) { %><div class="new-party" data-new-party-box>
          <span class="small muted">Not on Parties yet — added when you book (edit if needed):</span>
          <input name="new_party_name" value="<%= nv.name %>" placeholder="Vendor name">
          <select name="new_party_type"><% [['vendor', 'Vendor (CFS / carrier / terminal / other)'], ['trucker', 'Trucker'], ['broker', 'Customs broker'], ['delivery', 'Warehouse / delivery location'], ['agent', 'Overseas agent']].forEach(([v, l]) => { %><option value="<%= v %>" <%= /CFS|WAREHOUSE/i.test(nv.name) && v === 'vendor' ? 'selected' : '' %>><%= l %></option><% }) %></select>
          <textarea name="new_party_address" rows="2" placeholder="Address"><%= nv.address || '' %></textarea>
          <input name="new_party_email" value="<%= nv.email || '' %>" placeholder="Email (vendor invoices from this address are matched automatically)">
          <input type="hidden" name="new_party_phone" value="<%= nv.phone || '' %>"></div>
        <% } else if (ex.vendor_name_read && !ex.vendor) { %><span class="small muted">On the invoice: <%= ex.vendor_name_read %> — add it on Parties if new</span><% } %></div>
      <div class="field"><label>File</label><select name="shipment_id"><option value="">— no file (overhead) —</option>
        <% files.forEach((s) => { %><option value="<%= s.id %>" <%= sid === s.id ? 'selected' : '' %>><%= matchedIds.includes(s.id) ? '★ ' : '' %><%= S.fileName(s) %> · <%= s.ref_no %></option><% }) %></select>
        <span class="small muted">★ = matched from the invoice (container / B/L)</span></div>
      <div class="field"><label>Vendor invoice no.</label><input name="number" value="<%= ex.number || '' %>" required class="mono"></div>
      <div class="field"><label>Invoice date</label><input type="date" name="invoice_date" value="<%= ex.invoice_date || '' %>"></div>
      <div class="field"><label>Terms (days)</label><input type="number" name="terms_days" value="<%= ex.terms_days ?? '' %>" placeholder="vendor default"></div>
      <div class="field"><label>Due date</label><input type="date" name="due_date" value="<%= ex.due_date || '' %>"></div>
    </div>
    <div class="tablewrap"><table class="t lines" data-lines="bill">
      <thead><tr><th style="min-width:200px">Charge</th><th>Qty</th><th>Rate</th><th>Amount</th><th></th></tr></thead>
      <tbody><% lines.forEach((l) => { %><tr>
        <td><input name="l_desc" value="<%= l.description || '' %>" list="charge-codes"></td>
        <td><input name="l_qty" value="<%= l.qty ?? '' %>" style="width:64px"></td><td><input name="l_rate" value="<%= l.rate ?? '' %>" style="width:90px"></td>
        <td><input name="l_amount" value="<%= l.amount ?? '' %>" style="width:110px" data-amt></td>
        <td><button type="button" class="btn secondary small" data-remove-row>✕</button></td></tr><% }) %></tbody>
    </table></div>
    <datalist id="charge-codes"><% codes.forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
    <div class="billsum"><button type="button" class="btn secondary small" data-add-row="bill">+ Line</button>
      <span>Lines total <b data-sum>0.00</b></span><span>Invoice total <b data-total="<%= ex.total ?? '' %>"><%= ex.total != null ? fmtNum(ex.total, 2) : '—' %></b></span><span data-diff class="late"></span></div>
    <div class="field"><label>Memo</label><input name="memo" placeholder="optional"></div>
    <div class="actions">
      <button class="btn" name="next" value="0">✔ Book vendor bill</button>
      <% if (nextId) { %><button class="btn secondary" name="next" value="1">✔ Book &amp; next</button><% } %>
    </div>
  </form>
</div>
<%- include('../partials/foot') %>
