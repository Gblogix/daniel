<%# locals: s, tr, big %>
<div class="track <%= tr.phase %> <%= locals.big ? 'track-big' : '' %>">
  <div class="track-route">
    <div><b><%= s.pol || 'Origin' %></b><br><%= s.atd ? 'ATD' : 'ETD' %> <%= s.atd || s.etd || 'TBA' %></div>
    <div class="right"><b><%= s.pod || 'Destination' %></b><br><%= s.ata ? 'ATA' : 'ETA' %> <%= s.ata || s.eta || 'TBA' %></div>
  </div>
  <% if (tr.days.length) { %>
    <% const n = tr.days.length; const every = Math.max(1, Math.ceil(n / (locals.big ? 16 : 8)));
       const WD = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']; %>
    <div class="track-bar" role="img" aria-label="<%= tr.percent %>% of transit time elapsed">
      <span class="vessel <%= ["FCL","LCL","TRUCK"].includes(s.mode) ? "flip" : "" %>" style="left: <%= Math.min(98, Math.max(2, tr.percent)) %>%"><%= tr.mode.icon %></span>
      <div class="track-dates" aria-hidden="true">
        <% const cur = tr.days.findIndex((d) => d.state === 'current'); const half = Math.ceil(every / 2);
           tr.days.forEach((d, i) => { const dt = new Date(`${d.date}T00:00:00Z`);
             const near = (j) => every > 1 && j >= 0 && j !== i && Math.abs(j - i) < half;
             const show = i === cur || i === n - 1 || (i % every === 0 && n - 1 - i >= half && !near(cur)); %>
          <span class="<%= i === cur ? 'today' : '' %>"><% if (show) { %><b><%= dt.getUTCMonth() + 1 %>/<%= dt.getUTCDate() %></b><% if (locals.big) { %><i><%= i === cur ? 'Today' : WD[dt.getUTCDay()] %></i><% } %><% } %></span>
        <% }) %>
      </div>
      <div class="track-cells"><% tr.days.forEach((d) => { %><span class="cell <%= d.state %>" title="<%= d.date %>"></span><% }) %></div>
    </div>
    <div class="track-meta">
      <span class="left">
        <% if (tr.phase === 'arrived') { %>Arrived
        <% } else if (tr.phase === 'delayed') { %>Past ETA — awaiting arrival update
        <% } else if (tr.phase === 'waiting') { %>Departs in <%= tr.daysToDeparture %> day(s) · <%= tr.totalDays %>-day transit
        <% } else { %>Day <%= tr.totalDays - tr.daysLeft %> of <%= tr.totalDays %> · <%= tr.daysLeft %> day(s) to arrival<% } %>
      </span>
      <span><%= tr.percent %>%</span>
    </div>
  <% } else { %>
    <div class="muted small">Schedule to be advised (ETD / ETA not set yet)</div>
  <% } %>
</div>
