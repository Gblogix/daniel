<%# Shipment form fields. locals: s, customers, agents, brokers, truckers, deliveries, sources (optional) %>
<%
  const e = (v) => String(v ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  const src = (k) => locals.sources && sources[k] ? `<span class="src" title="from ${e(sources[k])}">${e(sources[k])}</span>` : '';
  const inp = (k, label, type = 'text', extra = '') => `<div class="field"><label for="f_${k}">${label}${src(k)}</label><input id="f_${k}" name="${k}" type="${type}" value="${e(s[k])}" ${extra}></div>`;
  // Imperial next to metric: shown only, never saved — KG / CBM stay the stored values.
  const conv = (unit, v) => (v == null || v === '' || Number.isNaN(Number(v)) ? '' : (Math.round(Number(v) * (unit === 'lbs' ? 2.20462 : 35.3147) * 100) / 100));
  const sel = (k, label, opts, blank = true) => `<div class="field"><label for="f_${k}">${label}</label><select id="f_${k}" name="${k}">${blank ? '<option value="">—</option>' : ''}${opts.map((o) => `<option value="${e(o.id)}" ${String(s[k]) === String(o.id) ? 'selected' : ''}>${e(o.name)}</option>`).join('')}</select></div>`;
%>
<% const misc = s.mode === 'OTHER'; const ship = (html) => html.replace('<div class="field">', `<div class="field" data-ship-only ${misc ? 'hidden' : ''}>`); %>
<%# Air files have no ISF, vessel, containers, OBL…: those boxes are hidden (and come back if the mode is changed). %>
<% const isAir = s.mode === 'AIR'; const only = (attr, hide) => (html) => html.replace('<div class="field"', `<div ${attr} ${hide ? 'hidden' : ''} class="field"`);
   const oc = only('data-ocean-only', isAir); const ai = only('data-air-only', !isAir); const fcl = only('data-fcl-only', s.mode !== 'FCL'); %>
<script type="application/json" id="required-fields"><%- JSON.stringify(Object.fromEntries(Object.entries(S.REQUIRED).map(([m, l]) => [m, l.map(([k]) => k)]))) %></script>
<%# OPUS-style entry: tabs on top, the main tab in columns with the label beside each box — one screen, little scrolling. %>
<% const ta = (k, label, rows = 2) => `<div class="field"><label for="f_${k}">${label}${src(k)}</label><textarea id="f_${k}" name="${k}" rows="${rows}">${e(s[k])}</textarea></div>`;
   const nCtn = (s.containers || []).filter((c) => c.container_no).length; const nItem = (s.items || []).filter((i) => i.description).length;
   const held0 = String(s.holds || '').split(/,\s*/).filter(Boolean); %>
<div class="fileform opus" id="file-form">
<div class="ff-tabs" role="tablist" aria-label="File sections">
  <a role="tab" href="#main" data-tab="main" class="on"><%= isAir ? 'AWB' : 'B/L' %> &amp; parties</a>
  <a role="tab" href="#clear" data-tab="clear" data-ship-only <%= misc ? 'hidden' : '' %>>Clearance &amp; delivery<%= held0.length ? ' ⚠' : '' %></a>
  <a role="tab" href="#ctns" data-tab="ctns" data-ship-only data-ocean-only <%= misc || isAir ? 'hidden' : '' %>>Containers<%= nCtn ? ` (${nCtn})` : '' %></a>
  <a role="tab" href="#items" data-tab="items" data-ship-only <%= misc ? 'hidden' : '' %>>P/L<%= nItem ? ` (${nItem})` : '' %></a>
  <a role="tab" href="#notes" data-tab="notes"><%= canAccounting ? 'Billing & notes' : 'Notes' %><%= s.notes ? ' •' : '' %></a>
</div>

<section class="ff-pane" data-pane="main" role="tabpanel">
<div class="ff-cols">
  <div class="ff-col">
    <h4>Customer</h4>
    <% if (locals.newCustomer) { const nc = newCustomer; %>
    <div class="field"><label for="f_customer_id">Customer</label><select id="f_customer_id" name="customer_id" data-new-party>
      <option value="">—</option><option value="new" <%= s.customer_id ? '' : 'selected' %>>＋ New customer from documents: <%= nc.name %></option>
      <% customers.forEach((o) => { %><option value="<%= o.id %>" <%= String(s.customer_id) === String(o.id) ? 'selected' : '' %>><%= o.name %></option><% }) %></select>
      <div class="new-party" data-new-party-box <%= s.customer_id ? 'hidden' : '' %>>
        <span class="small muted">Not on Parties yet — added as a customer when you apply (edit if needed):</span>
        <input name="new_party_name" value="<%= nc.name %>" placeholder="Company name">
        <textarea name="new_party_address" rows="2" placeholder="Address"><%= nc.address || '' %></textarea>
        <input name="new_party_email" value="<%= nc.email || '' %>" placeholder="Notice / billing email (optional)">
        <input type="hidden" name="new_party_phone" value="<%= nc.phone || '' %>"><input type="hidden" name="new_party_type" value="customer"></div></div>
    <% } else { %><%- sel('customer_id', 'Customer', customers) %><% } %>
    <%- sel('bill_to_id', 'Bill to', customers) %>
    <div data-ship-only <%= misc ? 'hidden' : '' %>>
      <%- inp('shipper_name', 'Shipper', 'text', 'data-party-lookup="shipper" data-address="f_shipper_address" autocomplete="off"') %><%- ta('shipper_address', '<span class="sr">Shipper </span>Address') %>
      <%- inp('consignee_name', 'Consignee', 'text', 'data-party-lookup="consignee" data-address="f_consignee_address" autocomplete="off"') %><%- ta('consignee_address', '<span class="sr">Consignee </span>Address') %>
      <%- inp('notify_party', 'Notify', 'text', 'data-party-lookup="notify" data-address="f_notify_address" autocomplete="off"') %><%- ta('notify_address', '<span class="sr">Notify </span>Address') %>
      <%- sel('agent_id', 'Agent', agents) %>
      <%- sel('broker_id', 'Customs broker', brokers) %>
      <%- sel('trucker_id', 'Trucker', truckers) %>
    </div>
  </div>

  <div class="ff-col" data-ship-only <%= misc ? 'hidden' : '' %>>
    <h4><%= isAir ? 'Flight' : 'Vessel' %> &amp; route</h4>
    <%- inp('mbl_no', isAir ? 'MAWB No.' : 'MBL No.', 'text', 'class="mono"') %>
    <%- inp('hbl_no', isAir ? 'HAWB No.' : 'HBL No.', 'text', 'class="mono"') %>
    <%- inp('sub_bl_no', 'Sub B/L No.') %>
    <%- inp('carrier', isAir ? 'Airline' : 'Carrier') %>
    <%- inp('scac', isAir ? 'Airline prefix' : 'SCAC', 'text', 'placeholder="auto from MBL"') %>
    <div data-ocean-only <%= isAir ? 'hidden' : '' %> class="field ff-pair"><label for="f_vessel">VSL / VOY<%- src('vessel') %></label><div class="ff-two">
      <input id="f_vessel" name="vessel" value="<%= s.vessel || '' %>" placeholder="Vessel"><input id="f_voyage" name="voyage" value="<%= s.voyage || '' %>" placeholder="Voy." aria-label="Voyage" class="ff-short"></div></div>
    <%- ai(inp('flight_no', 'Flight No.')) %>
    <%- inp('pol', isAir ? 'Departure' : 'POL') %>
    <%- inp('etd', 'ETD', 'date') %>
    <%- inp('pod', isAir ? 'Destination' : 'POD') %>
    <%- inp('eta', 'ETA', 'date') %>
    <% if (s.id && locals.trackingStatus) { %><div class="small ff-note eta-src">
      <% if (trackingStatus.any && s.tracking_checked_at) { %><span class="muted">ETA auto · <%= fmtDateTime(s.tracking_checked_at) %> UTC</span>
      <% } else if (trackingStatus.any) { %><span class="muted">ETA auto after saving (needs MBL)</span>
      <% } else { %><span class="muted" title="No tracking API connected — the ETA comes from the documents (ISF / arrival notice) or is typed in">ETA manual (no tracking link)</span><% } %>
      <% if (locals.trackLink) { %> · <a href="<%= trackLink.url %>" target="_blank" rel="noopener">🔎 <%= trackLink.label %> ↗</a><% } %></div><% } %>
    <%- inp('atd', 'ATD (actual)', 'date') %>
    <%- inp('ata', 'ATA (actual)', 'date') %>
    <%- inp('place_of_delivery', 'Place of delivery') %>
    <%- inp('final_destination', 'Final dest.') %>
    <%- oc(inp('ams_bl_no', 'AMS B/L No.')) %>
    <%- oc(inp('isf_no', 'ISF / AMS ref')) %>
  </div>

  <div class="ff-col" data-ship-only <%= misc ? 'hidden' : '' %>>
    <h4>Pick-up &amp; I.T.</h4>
    <%- inp('cfs_location', isAir ? 'Cargo location' : 'CY / CFS', 'text', `title="${isAir ? 'Airline warehouse / cargo terminal' : 'Freight location: terminal / CFS / CES'}"`) %>
    <div class="field"><label for="f_cfs_address">Location addr.</label><textarea id="f_cfs_address" name="cfs_address" rows="2" placeholder="Address of the <%= isAir ? 'cargo terminal / warehouse' : 'terminal / CFS' %>"><%= s.cfs_address || '' %></textarea></div>
    <%- inp('freight_location_tel', 'Location tel') %>
    <%- inp('firms_code', 'Firms code') %>
    <%- oc(inp('devan_location', 'Devan location')) %>
    <%- inp('available_date', 'Available', 'date') %>
    <%- inp('last_free_day', 'LFD', 'date') %>
    <%- inp('go_date', 'G.O. date', 'date') %>
    <%- inp('it_no', 'I.T. No.') %>
    <%- inp('it_place', 'I.T. place') %>
    <%- inp('it_date', 'I.T. date', 'date') %>
    <div data-ocean-only <%= isAir ? 'hidden' : '' %> class="field"><label for="f_service_term">SVC term</label><select id="f_service_term" name="service_term"><option value="">—</option>
      <% ['CY/CY', 'CFS/CFS', 'CY/CFS', 'CFS/CY', 'CY/DOOR', 'CFS/DOOR'].forEach((o) => { %><option <%= s.service_term === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
    <div data-ocean-only <%= isAir ? 'hidden' : '' %> class="field"><label for="f_release_type">Release</label><select id="f_release_type" name="release_type"><option value="">—</option>
      <% ['EXPRESS RELEASE', 'TELEX RELEASE', 'ORIGINAL B/L', 'SEA WAYBILL'].forEach((o) => { %><option <%= s.release_type === o ? 'selected' : '' %>><%= o %></option><% }) %></select></div>
    <div class="ff-checks">
      <label class="check" data-ocean-only <%= isAir ? 'hidden' : '' %>><input type="checkbox" name="isf_filed" value="1" <%= s.isf_filed ? 'checked' : '' %>> ISF filed</label>
      <label class="check" data-ocean-only <%= isAir ? 'hidden' : '' %>><input type="checkbox" name="telex_release" value="1" <%= s.telex_release ? 'checked' : '' %>> Telex / OBL received</label>
      <label class="check"><input type="checkbox" name="direct_shipment" value="1" <%= s.direct_shipment ? 'checked' : '' %>> Direct (no HBL)</label>
    </div>
  </div>

  <div class="ff-col">
    <h4>Shipment &amp; cargo</h4>
    <%- sel('mode', 'Mode', Object.entries(S.MODES).map(([id, m]) => ({ id, name: m.label })), false) %>
    <div class="field" data-misc-only <%= misc ? '' : 'hidden' %>><label for="f_title" title='e.g. "Office expenses 2026", "Unlockt — storage"'>File name</label>
      <input id="f_title" name="title" value="<%= s.title || '' %>" placeholder="What these invoices are for"></div>
    <%- ship(sel('status', 'Status', S.STATUSES.map((x) => ({ id: x.code, name: `${x.label} (${x.ko})` })), false)) %>
    <%- ship(sel('customs_status', 'Customs', S.CUSTOMS_STATUSES.map((x) => ({ id: x, name: x })), false)) %>
    <%- ship(sel('origin_country', 'Origin', [{ id: 'KR', name: 'Korea' }, { id: 'CN', name: 'China' }, { id: 'VN', name: 'Vietnam' }, { id: 'OTHER', name: 'Other' }])) %>
    <% if (locals.staffUsers) { %><%- sel('owner_id', 'OP (PIC)', staffUsers) %><%- sel('sales_id', 'Sales', staffUsers) %><% } %>
    <div data-ship-only <%= misc ? 'hidden' : '' %>>
      <div class="field ff-pair"><label for="f_packages">Package<%- src('packages') %></label><div class="ff-two">
        <input id="f_packages" name="packages" type="number" step="1" value="<%= s.packages ?? '' %>"><input id="f_package_unit" name="package_unit" value="<%= s.package_unit || '' %>" placeholder="CTNS" aria-label="Package unit" class="ff-short"></div></div>
      <div class="field ff-pair"><label for="f_weight_kg">Weight<%- src('weight_kg') %></label><div class="ff-two ff-units">
        <input id="f_weight_kg" name="weight_kg" type="number" step="0.01" value="<%= s.weight_kg ?? '' %>"><span>KG</span>
        <input id="f_weight_lbs" type="text" readonly tabindex="-1" class="conv-ro" data-conv="lbs" data-conv-of="weight_kg" value="<%= conv('lbs', s.weight_kg) %>" title="Pounds — worked out from KG" aria-label="LBS (auto)"><span>LB</span></div></div>
      <div class="field ff-pair"><label for="f_cbm">Measure<%- src('cbm') %></label><div class="ff-two ff-units">
        <input id="f_cbm" name="cbm" type="number" step="0.001" value="<%= s.cbm ?? '' %>"><span>CBM</span>
        <input id="f_cft" type="text" readonly tabindex="-1" class="conv-ro" data-conv="ft³" data-conv-of="cbm" value="<%= conv('ft³', s.cbm) %>" title="Cubic feet — worked out from CBM" aria-label="FT³ (auto)"><span>FT³</span></div></div>
      <%- ai(inp('chargeable_weight', 'Chargeable KG', 'number', 'step="0.01"')) %>
      <%- inp('commodity', 'Commodity') %>
      <%- inp('marks', 'Marks') %>
      <%- inp('ci_invoice_no', 'C/I No.') %>
      <%- inp('cargo_value', 'Value (USD)', 'number', 'step="0.01"') %>
      <%- inp('customer_ref', 'Customer ref.') %>
      <%- inp('agent_ref', 'Agent filing No.') %>
    </div>
  </div>
</div>
</section>

<section class="ff-pane" data-pane="clear" role="tabpanel" hidden>
<div class="ff-cols ff-cols-2" data-ship-only <%= misc ? 'hidden' : '' %>>
  <div class="ff-col">
    <h4>Clearance &amp; release</h4>
    <%- inp('entry_no', 'Entry No.', 'text', 'placeholder="8TV-2703851-3"') %>
    <%- inp('css_no', 'CES / CSS No.') %>
    <%- inp('storage_start', 'Storage begins', 'date') %>
    <%- inp('pallets', 'Pallets', 'number', 'step="1"') %>
    <div class="field"><label>Holds</label><div class="ff-checks inline">
      <% S.HOLD_TYPES.forEach((h) => { %><label class="check"><input type="checkbox" name="holds" value="<%= h %>" <%= held0.includes(h) ? 'checked' : '' %>> <%= h %></label><% }) %>
      <input type="hidden" name="holds" value=""></div></div>
    <div class="ff-checks">
      <label class="check"><input type="checkbox" name="freight_paid" value="1" <%= s.freight_paid ? 'checked' : '' %>> <span data-air-only <%= isAir ? '' : 'hidden' %>>Import Service Fee paid</span><span data-ocean-only <%= isAir ? 'hidden' : '' %>>Carrier freight &amp; fees paid</span></label>
      <label class="check" data-fcl-only <%= s.mode === 'FCL' ? '' : 'hidden' %>><input type="checkbox" name="pierpass_paid" value="1" <%= s.pierpass_paid ? 'checked' : '' %>> PierPass / CTF paid</label>
      <label class="check"><input type="checkbox" name="carrier_released" value="1" <%= s.carrier_released ? 'checked' : '' %>> Carrier / terminal released</label>
      <label class="check"><input type="checkbox" name="pod_received" value="1" <%= s.pod_received ? 'checked' : '' %>> POD received</label>
      <label class="check"><input type="checkbox" name="tracking_enabled" value="1" <%= s.tracking_enabled === 0 ? '' : 'checked' %>> Auto-tracking on</label>
    </div>
  </div>
  <div class="ff-col">
    <h4>Pick-up &amp; delivery</h4>
    <% if (s.delivery_request_at && !s.delivery_request_done) { %>
      <div class="warnbox">📅 <b>Customer requested delivery:</b> <%= s.delivery_request_date || '' %> <%= s.delivery_request_time || '' %>
        <%= s.delivery_request_note ? `— “${s.delivery_request_note}”` : '' %> <span class="muted small">(<%= fmtDateTime(s.delivery_request_at) %> UTC)</span>
        <div class="small" style="margin-top:6px"><label class="check"><input type="checkbox" name="accept_delivery_request" value="1"> Use this date / time and mark the request handled (the customer is notified)</label></div></div>
    <% } %>
    <div class="field"><label for="f_available_for_pickup">Avail. for pickup</label><select id="f_available_for_pickup" name="available_for_pickup">
      <option value="" <%= s.available_for_pickup == null ? 'selected' : '' %>>Unknown</option><option value="1" <%= s.available_for_pickup === 1 ? 'selected' : '' %>>Yes</option><option value="0" <%= s.available_for_pickup === 0 ? 'selected' : '' %>>No</option></select></div>
    <%- inp('pickup_appt', 'Pickup appt.', 'datetime-local') %>
    <%- inp('picked_up_at', 'Picked up', 'date') %>
    <%- fcl(inp('empty_returned_at', 'Empty returned', 'date')) %>
    <%- sel('delivery_company_id', 'Deliver to', deliveries.concat(customers)) %>
    <%- ta('delivery_address', 'Delivery addr.') %>
    <%- inp('delivery_date', 'Delivery date', 'date') %>
    <%- inp('delivery_time', 'Delivery time', 'time') %>
  </div>
</div>
</section>

<section class="ff-pane" data-pane="notes" role="tabpanel" hidden>
<div class="ff-cols ff-cols-2">
  <% if (canAccounting) { %><div class="ff-col">
    <h4>Billing</h4>
    <%- inp('service_price', 'Service price', 'number', 'step="0.01"') %>
    <%- inp('invoice_no', 'Invoice No.') %>
    <%- inp('invoice_amount', 'Invoice amount', 'number', 'step="0.01"') %>
    <div class="ff-checks"><label class="check"><input type="checkbox" name="paid" value="1" <%= s.paid ? 'checked' : '' %>> Paid</label></div>
    <p class="muted small">Charges are billed with AR invoices / debit notes (Accounting on the file page). The A/N prints the customer's AR invoice.</p>
  </div><% } %>
  <div class="ff-col">
    <h4>Internal notes</h4>
    <div class="field ff-full"><label for="f_notes" class="sr">Internal notes</label><textarea id="f_notes" name="notes" rows="6"><%= s.notes || '' %></textarea></div>
  </div>
</div>
</section>

<section class="ff-pane" data-pane="ctns" role="tabpanel" hidden><div data-ship-only data-ocean-only <%= misc || isAir ? "hidden" : "" %>>
  <div class="tablewrap"><table class="t lines ctn-lines" data-lines="ctn">
    <thead><tr><th>Container No.</th><th>Seal No.</th><th>Size/Type</th><th>Pkgs</th><th>KG</th><th>LBS</th><th>CBM</th><th>FT³</th><th>Pickup no.</th><th>LFD</th><th>Terminal status</th><th></th></tr></thead>
    <tbody>
    <% const ctns = s.containers && s.containers.length ? s.containers : [{}]; ctns.forEach((c) => { %>
      <tr>
        <td><input name="ctn_no" value="<%= c.container_no || '' %>" class="mono" placeholder="ABCU1234567"></td>
        <td><input name="ctn_seal" value="<%= c.seal_no || '' %>"></td>
        <td><input name="ctn_size" value="<%= c.size_type || '' %>" placeholder="40HC"></td>
        <td><input name="ctn_pkgs" value="<%= c.packages ?? '' %>"></td>
        <td><input name="ctn_kg" value="<%= c.weight_kg ?? '' %>"></td>
        <td><input data-conv="lbs" data-conv-of="ctn_kg" value="<%= conv('lbs', c.weight_kg) %>" readonly tabindex="-1" class="conv-ro" title="Pounds — worked out from KG"></td>
        <td><input name="ctn_cbm" value="<%= c.cbm ?? '' %>"></td>
        <td><input data-conv="ft³" data-conv-of="ctn_cbm" value="<%= conv('ft³', c.cbm) %>" readonly tabindex="-1" class="conv-ro" title="Cubic feet — worked out from CBM"></td>
        <td><input name="ctn_pickup" value="<%= c.pickup_no || '' %>"></td>
        <td><input name="ctn_lfd" value="<%= c.pickup_lfd || '' %>" type="date"></td>
        <td class="small nowrap"><%= [c.current_status, c.available === 1 ? 'available' : c.available === 0 ? 'not available' : '', c.holds].filter(Boolean).join(' · ') %></td>
        <td><button type="button" class="btn secondary small" data-remove-row>✕</button></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <button type="button" class="btn secondary small" data-add-row="ctn" style="margin-top:8px">+ Container</button>
</div></section>

<section class="ff-pane" data-pane="items" role="tabpanel" hidden><div data-ship-only <%= misc ? "hidden" : "" %>>
  <% const items = s.items && s.items.length ? s.items : [{}];
     const groups = {};
     items.filter((i) => i.description).forEach((i) => { const g = groups[i.buyer || '—'] = groups[i.buyer || '—'] || { invoices: new Set(), lines: 0, pkgs: 0, kg: 0, cbm: 0 };
       if (i.invoice_no) g.invoices.add(i.invoice_no); g.lines++; g.pkgs += Number(i.packages) || 0; g.kg += Number(i.weight_kg) || 0; g.cbm += Number(i.cbm) || 0; });
     const buyers = Object.keys(groups); %>
  <% if (buyers.length > 1 || (buyers.length === 1 && buyers[0] !== '—')) { %>
  <div class="buyer-sum" data-buyer-filter>
    <button type="button" class="buyer-chip on" data-buyer="">All <span class="muted">(<%= items.filter((i) => i.description).length %>)</span></button>
    <% buyers.forEach((b) => { const g = groups[b]; %><button type="button" class="buyer-chip" data-buyer="<%= b === '—' ? '' : b %>" data-only="<%= b %>">
      <b><%= b === '—' ? 'No buyer' : b %></b> <span class="muted small"><%= [...g.invoices].join(', ') || 'no invoice' %> · <%= g.lines %> line<%= g.lines === 1 ? "" : "s" %> · <%= g.pkgs || '—' %> pkgs · <%= g.kg ? `${fmtNum(g.kg, 1)} kg (${fmtNum(g.kg * 2.20462, 1)} lbs)` : '— kg' %> · <%= g.cbm ? `${fmtNum(g.cbm, 3)} cbm (${fmtNum(g.cbm * 35.3147, 1)} ft³)` : '— cbm' %></span></button><% }) %>
  </div><% } %>
  <div class="tablewrap"><table class="t lines item-lines" data-lines="item">
    <thead><tr><th>Final buyer</th><th>Invoice no.</th><th>PO / SKU</th><th style="min-width:220px">Description</th><th>HS code</th><th>Qty</th><th>Unit</th><th>Pkgs</th><th>KG</th><th>LBS</th><th>CBM</th><th>FT³</th><th></th></tr></thead>
    <tbody>
    <% items.forEach((i) => { %>
      <tr data-buyer-row="<%= i.buyer || '—' %>">
        <td><input name="item_buyer" value="<%= i.buyer || '' %>" list="buyer-list" placeholder="Target…" style="min-width:90px"></td>
        <td><input name="item_inv" value="<%= i.invoice_no || '' %>" style="min-width:110px"></td>
        <td><input name="item_po" value="<%= i.po_no || '' %>"></td>
        <td><input name="item_desc" value="<%= i.description || '' %>"></td>
        <td><input name="item_hs" value="<%= i.hs_code || '' %>"></td>
        <td><input name="item_qty" value="<%= i.quantity ?? '' %>"></td>
        <td><input name="item_unit" value="<%= i.unit || '' %>"></td>
        <td><input name="item_pkgs" value="<%= i.packages ?? '' %>"></td>
        <td><input name="item_kg" value="<%= i.weight_kg ?? '' %>"></td>
        <td><input data-conv="lbs" data-conv-of="item_kg" value="<%= conv('lbs', i.weight_kg) %>" readonly tabindex="-1" class="conv-ro" title="Pounds — worked out from KG"></td>
        <td><input name="item_cbm" value="<%= i.cbm ?? '' %>"></td>
        <td><input data-conv="ft³" data-conv-of="item_cbm" value="<%= conv('ft³', i.cbm) %>" readonly tabindex="-1" class="conv-ro" title="Cubic feet — worked out from CBM"></td>
        <td><input type="hidden" name="item_price" value="<%= i.unit_price ?? '' %>"><input type="hidden" name="item_amount" value="<%= i.amount ?? '' %>">
          <button type="button" class="btn secondary small" data-remove-row>✕</button></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div>
  <datalist id="buyer-list"><% ['Target', 'Nordstrom', 'Nordstrom Rack', 'Ulta', 'Walmart', 'Costco', 'Sephora', 'Amazon', 'TJ Maxx', "Macy's", 'CVS', 'Ipsy', ...buyers.filter((b) => b !== '—')].filter((v, k, a) => a.indexOf(v) === k).forEach((b) => { %><option value="<%= b %>"><% }) %></datalist>
  <button type="button" class="btn secondary small" data-add-row="item" style="margin-top:8px">+ Line</button>
  <span class="muted small">Lines are sorted by final buyer, then invoice, when saved.</span>
</div></section>
</div>
