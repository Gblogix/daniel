<%# Party <option>s grouped by type, the likely types first. locals: parties, selected, prefer (array of types) %>
<%
  const LABEL = { customer: 'Customers', agent: 'Overseas agents', broker: 'Customs brokers', trucker: 'Truckers', vendor: 'Vendors (CFS / carrier / other)',
    delivery: 'Delivery locations / warehouses', importer: 'Importers', shipper: 'Shippers' };
  const order = [...(locals.prefer || []), ...Object.keys(LABEL)].filter((t, i, a) => a.indexOf(t) === i);
  const groups = {};
  parties.forEach((p) => { (groups[p.type] = groups[p.type] || []).push(p); });
  const types = [...order.filter((t) => groups[t]), ...Object.keys(groups).filter((t) => !order.includes(t))];
%>
<% types.forEach((t) => { %><optgroup label="<%= LABEL[t] || t %>"><% groups[t].forEach((p) => { %><option value="<%= p.id %>" data-type="<%= p.type %>" <%= String(selected) === String(p.id) ? 'selected' : '' %>><%= p.name %></option><% }) %></optgroup><% }) %>
