<%- include('../partials/head') %>
<div class="pagehead"><h1>Automation</h1></div>
<form class="card" method="post" action="/admin/settings" style="max-width:760px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% settings.forEach((st) => { %>
    <label class="check" style="padding:8px 0;border-bottom:1px solid var(--line)"><input type="checkbox" name="<%= st.k %>" value="1" <%= st.on ? 'checked' : '' %>> <%= st.label %></label>
  <% }) %>
  <p class="muted small">Email delivery: <b><%= config.mailTransport === 'outlook' ? `Outlook / Microsoft 365 (${config.graph.mailbox})` : config.mailTransport === 'smtp' ? `SMTP ${config.smtp.host}` : 'not configured — emails are stored in the Outbox only' %></b> ·
    AI extraction: <b><%= config.ai.enabled ? `on (${config.ai.model})` : 'off — rule-based extraction' %></b></p>
  <button class="btn">Save</button>
</form>
<div class="card" style="max-width:760px" id="backup">
  <h2>Backup</h2>
  <% if (!backup.dir) { %><p class="small" style="color:var(--red)">⚠ Backup is OFF. Add <code>BACKUP_DIR=C:\Users\…\OneDrive\GB Logix Backup</code> to the <code>.env</code> file and restart — the database and uploaded files are then copied there every night.</p>
  <% } else { %><p class="small">Every night after 2am to <code><%= backup.dir %></code> (database copies kept 30 days, uploaded files mirrored).</p><% } %>
  <% if (backup.last) { %><p class="small muted">Last backup <%= fmtDateTime(backup.last.at) %> UTC — <%= Math.round(backup.last.size / 1024) %> KB database, <%= backup.last.files %> new file(s).</p><% } %>
  <% if (backup.error) { %><p class="small" style="color:var(--red)">Last error: <%= backup.error %></p><% } %>
  <form method="post" action="/admin/backup/run"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary small" <%= backup.dir ? '' : 'disabled' %>>⤓ Back up now</button></form>
</div>
<div class="card" style="max-width:760px">
  <h2>Smartsheet</h2>
  <p class="small"><%= smartsheet.token ? '✔ API token set' : 'Not connected — set SMARTSHEET_TOKEN (Smartsheet › Personal settings › API access)' %>.
    Sheets read: Unlockt - GlobalBridge, Delivery Status_Unlockt, Seorin, Other Solvenza, Lumare, ATELIER QUINCE, OPULEN, BK Trading, Leepop Inc.</p>
  <% if (smartsheet.last) { %><p class="small muted">Last sync <%= fmtDateTime(smartsheet.last.at) %> UTC:
    <%= smartsheet.last.results.map((x) => x.error ? `${x.sheet}: ${x.error}` : `${x.sheet} +${x.created}/${x.updated}/${x.attachments} files`).join(' · ') %></p><% } %>
  <form method="post" action="/admin/smartsheet/run"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn secondary small" <%= smartsheet.token ? '' : 'disabled' %>>↻ Sync now</button></form>
</div>
<div class="card" style="max-width:760px">
  <h2>Tracking sources</h2>
  <table class="t">
    <tr><th>Ocean — carrier APIs (DCSA)</th><td><%= tracking.dcsa.length ? tracking.dcsa.join(', ') : 'not configured (DCSA_CARRIERS)' %></td></tr>
    <tr><th>Ocean — Terminal49</th><td><%= tracking.terminal49 ? '✔ connected' : 'not configured (TERMINAL49_API_KEY)' %></td></tr>
    <tr><th>Ocean + Air — ShipsGo</th><td><%= tracking.shipsgo ? '✔ connected' : 'not configured (SHIPSGO_API_KEY)' %></td></tr>
    <tr><th>Vessel GPS — Datalastic</th><td><%= tracking.datalastic ? '✔ connected' : 'not configured (DATALASTIC_API_KEY)' %></td></tr>
    <tr><th>Vessel GPS — aisstream.io</th><td><%= tracking.aisstream ? '✔ connected (coastal, by MMSI)' : 'not configured (AISSTREAM_API_KEY)' %></td></tr>
  </table>
  <form method="post" action="/admin/tracking/run" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <button class="btn secondary small" <%= tracking.any ? '' : 'disabled' %>>↻ Refresh all active shipments now</button></form>
</div>
<div class="card" id="reset" style="max-width:760px;border-color:#fecaca">
  <h2>Start fresh — remove test / demo data</h2>
  <p class="small">Deletes <b>all shipments</b> with their documents, invoices, payments, document intakes and email log, plus the demo logins
    (<span class="mono">*.example</span>, "(demo)"). Keeps admin accounts, parties (Unlockt, NSC, CTC…), company profile, numbering and settings.
    If Smartsheet is connected, the next sync brings the real files back in. This cannot be undone.</p>
  <form method="post" action="/admin/reset" class="actions"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <input name="confirm" placeholder="Type DELETE" style="width:160px" autocomplete="off">
    <button class="btn danger" data-confirm="Delete all shipments and test data? This cannot be undone.">Delete test data</button></form>
</div>
<%- include('../partials/foot') %>
