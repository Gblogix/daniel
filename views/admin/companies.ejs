<%- include('../partials/head') %>
<div class="pagehead"><h1>Parties</h1></div>
<div class="grid" style="grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr); align-items:start">
  <div class="tablewrap"><table class="t">
    <thead><tr><th>Name</th><th>Type</th><th>Country</th><th>Notice emails</th><th>Users</th><th></th></tr></thead>
    <% rows.forEach((c) => { %>
      <tr><td><b><%= c.name %></b><% if (c.address) { %><br><span class="small muted"><%= c.address %></span><% } %></td><td><%= COMPANY_TYPES[c.type] || c.type %></td><td><%= c.country || '' %></td>
        <td class="small"><%= c.emails || '' %><% if (!c.emails && ['customer','broker','trucker'].includes(c.type)) { %><span class="badge EXAM">no email — notices will be skipped</span><% } %></td>
        <td><%= c.users %></td><td><a class="btn secondary small" href="/companies/<%= c.id %>">Edit</a></td></tr>
    <% }) %>
  </table></div>
  <form class="card" method="post" action="/companies">
    <h2><%= edit ? 'Edit party' : 'Add party' %></h2>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% const c = edit || {}; if (edit) { %><input type="hidden" name="id" value="<%= c.id %>"><% } %>
    <div class="field"><label>Name</label><input name="name" value="<%= c.name || '' %>" required></div>
    <div class="field"><label>Type</label><select name="type"><% Object.entries(COMPANY_TYPES).forEach(([k, v]) => { %><option value="<%= k %>" <%= c.type === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
    <div class="field"><label>Country</label><input name="country" value="<%= c.country || '' %>" placeholder="US / KR / CN"></div>
    <div class="field"><label>Notice emails (comma separated)</label><input name="emails" value="<%= c.emails || '' %>"></div>
    <div class="field"><label>Phone</label><input name="phone" value="<%= c.phone || '' %>"></div>
    <div class="field"><label>Address</label><textarea name="address" rows="2"><%= c.address || '' %></textarea></div>
    <button class="btn">Save</button> <% if (edit) { %><a class="btn secondary" href="/companies">Cancel</a><% } %>
  </form>
</div>
<%- include('../partials/foot') %>
