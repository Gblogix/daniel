<%- include('../partials/head') %>
<div class="pagehead"><h1>Parties</h1></div>
<div class="grid" style="grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr); align-items:start">
  <div class="tablewrap"><table class="t">
    <thead><tr><th>Name</th><th>Type</th><th>Country</th><th>Notice emails</th><th>Users</th><th></th></tr></thead>
    <% rows.forEach((c) => { %>
      <tr><td><b><%= c.name %></b><% if (c.address) { %><br><span class="small muted"><%= c.address %></span><% } %></td><td><%= PT.of(c).map((t) => PT.SHORT[t] || t).join(' · ') %></td><td><%= c.country || '' %></td>
        <td class="small"><%= c.emails || '' %><% if (!c.emails && ['customer','broker','trucker'].some((t) => PT.has(c, t))) { %><span class="badge EXAM">no email — notices will be skipped</span><% } %></td>
        <td><%= c.users %></td><td><a class="btn secondary small" href="/companies/<%= c.id %>">Edit</a></td></tr>
    <% }) %>
  </table></div>
  <% if (can('parties')) { %><div>
  <% if (!edit) { %><div class="card dropzone party-reader" data-party-reader data-csrf="<%= csrf %>">
    <label class="drop-hint" style="padding:4px"><span class="ico">📄</span>
      <span><b>Add from a document</b> — drag a B/L, invoice or the Outlook email here, or <span class="pick">choose file</span><br>
        <span class="small muted">Shipper / consignee / bill-to / vendor letterhead are read — click one to fill the form.</span></span>
      <input type="file" multiple accept=".pdf,.jpg,.jpeg,.png,.xlsx,.msg,.eml"></label>
    <div data-party-results class="party-results"></div>
  </div><% } %>
  <form class="card" method="post" action="/companies" id="party-form">
    <h2><%= edit ? 'Edit party' : 'Add party' %></h2>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <% const c = edit || {}; if (edit) { %><input type="hidden" name="id" value="<%= c.id %>"><% } %>
    <div class="field"><label>Name</label><input name="name" value="<%= c.name || '' %>" required></div>
    <% const roles = edit ? PT.of(c) : ['customer']; %>
    <div class="field"><label>Type <span class="muted small">— tick every role this party plays; ● = main role</span></label>
      <div class="type-picks"><% Object.entries(COMPANY_TYPES).forEach(([k, v]) => { %>
        <label class="type-pick"><input type="checkbox" name="types" value="<%= k %>" <%= roles.includes(k) ? 'checked' : '' %>>
          <span><%= v %></span><input type="radio" name="type" value="<%= k %>" title="Main role" <%= roles[0] === k ? 'checked' : '' %>></label>
      <% }) %></div></div>
    <div class="field"><label>Country</label><input name="country" value="<%= c.country || '' %>" placeholder="US / KR / CN"></div>
    <div class="field"><label>Notice emails (comma separated)</label><input name="emails" value="<%= c.emails || '' %>"></div>
    <div class="field"><label>Billing emails (invoices / D/N / SOA)</label><input name="billing_emails" value="<%= c.billing_emails || '' %>"></div>
    <div class="grid g2" style="gap:8px"><div class="field"><label>Payment terms (days)</label><input name="terms_days" type="number" value="<%= c.terms_days ?? '' %>"></div>
      <div class="field"><label>Short name (file names)</label><input name="short_name" value="<%= c.short_name || '' %>" placeholder="Unlockt"></div></div>
    <div class="grid g2" style="gap:8px"><div class="field"><label>Credit limit (USD)</label><input name="credit_limit" inputmode="decimal" value="<%= c.credit_limit ?? '' %>" placeholder="e.g. 200000"></div>
      <div class="field"><label>&nbsp;</label><label class="check"><input type="checkbox" name="credit_hold" value="1" <%= c.credit_hold ? 'checked' : '' %>> Credit hold — no D/O release</label></div></div>
    <div class="field"><label>Credit note</label><input name="credit_note" value="<%= c.credit_note || '' %>" placeholder="e.g. bad credit — pay before release"></div>
    <% const hid = new Set(String(c.portal_hide || '').split(',')); %>
    <div class="field"><label>Hide on the customer portal</label><div class="small">
      <% Object.entries(PORTAL_HIDE).forEach(([k, l]) => { %><label class="check" style="margin:2px 0"><input type="checkbox" name="portal_hide" value="<%= k %>" <%= hid.has(k) ? 'checked' : '' %>> <%= l %></label><% }) %></div></div>
    <div class="field"><label>Phone</label><input name="phone" value="<%= c.phone || '' %>"></div>
    <div class="field"><label>Default person in charge (new files)</label><select name="default_pic_id"><option value="">— whoever creates the file —</option>
      <% staffUsers.forEach((u) => { %><option value="<%= u.id %>" <%= c.default_pic_id === u.id ? 'selected' : '' %>><%= u.name %></option><% }) %></select></div>
    <div class="grid g2" style="gap:8px"><div class="field"><label>Shipment report to customer</label><select name="report_frequency">
      <option value="">Off</option><option value="daily" <%= c.report_frequency === 'daily' ? 'selected' : '' %>>Daily (7am)</option><option value="weekly" <%= c.report_frequency === 'weekly' ? 'selected' : '' %>>Weekly (Monday 7am)</option></select></div>
      <div class="field"><label>Report emails (default: notice emails)</label><input name="report_emails" value="<%= c.report_emails || '' %>"></div></div>
    <div class="field"><label>Address (printed on invoices / A/N)</label><textarea name="address" rows="3"><%= c.address || '' %></textarea></div>
    <button class="btn">Save</button> <% if (edit) { %><a class="btn secondary" href="/companies">Cancel</a><% } %>
  </form></div><% } %>
</div>
<%- include('../partials/foot') %>
